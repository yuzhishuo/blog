---
import { Header, ThemeProvider } from 'astro-pure/components/basic'
import Footer from '@/components/Footer.astro'
import WebCrawlers from '@/components/WebCrawlers.astro'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor,
  ...props
} = Astro.props

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const pagefindIgnore = path === '/resume'
---

<html lang={config.locale.lang} data-pagefind-ignore={pagefindIgnore ? 'all' : undefined}>
  <head>
    <meta charset='utf-8' />
    <script is:inline>
      if (localStorage.getItem('cyber') === '1') {
        document.documentElement.classList.add('cyber')
      }
      ;(function () {
        function mountCyberToggle() {
          const dark = document.getElementById('toggleDarkMode')
          if (!dark || document.getElementById('toggleCyberMode')) {
            return
          }
          const btn = document.createElement('button')
          btn.id = 'toggleCyberMode'
          btn.type = 'button'
          btn.className =
            'box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border'
          btn.title = '赛博模式'
          btn.setAttribute('aria-label', '赛博模式')
          btn.innerHTML =
            '<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 7V3h4M13 3h4v4M17 13v4h-4M7 17H3v-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="10" cy="10" r="1.7" fill="currentColor"/></svg>'
          const sync = () => {
            btn.setAttribute(
              'aria-pressed',
              document.documentElement.classList.contains('cyber') ? 'true' : 'false'
            )
          }
          sync()
          btn.addEventListener('click', () => {
            const next = !document.documentElement.classList.contains('cyber')
            document.documentElement.classList.toggle('cyber', next)
            localStorage.setItem('cyber', next ? '1' : '0')
            sync()
          })
          dark.insertAdjacentElement('afterend', btn)
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', mountCyberToggle)
        } else {
          mountCyberToggle()
        }
        document.addEventListener('astro:page-load', mountCyberToggle)
      })()
    </script>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='flex justify-center bg-background text-foreground' {...props}>
    <WebCrawlers />
    <div
      id='main-container'
      class='w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'
    >
      <Header />
      <div class='flex-1 w-full'>
        <slot />
      </div>
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: var(--highlight-fg, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      /* Extend safe area for some special screens
       * https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/env
       * https://webkit.org/blog/7929/designing-websites-for-iphone-x/
       */
      #main-container {
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }
    </style>
  </body>
</html>
