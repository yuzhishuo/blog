---
import type { MarkdownHeading } from 'astro'
// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { Copyright, Hero, TOC } from 'astro-pure/components/pages'
import config from 'virtual:config'
import PageLayout from '@/layouts/ContentLayout.astro'
import ShareChina from '@/components/ShareChina.astro'
import ReadingProgress from '@/components/ReadingProgress.astro'
import PostNav from '@/components/PostNav.astro'
import { Giscus } from '@/components/giscus'
import { PageInfo } from '@/components/waline'
import { getReadingTime } from 'astro-pure/utils'
import type { BlogPost } from '@/lib/posts'

interface Props {
  post: BlogPost
  posts: BlogPost[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const { post, posts, headings, remarkPluginFrontmatter } = Astro.props
const { id, data } = post

const description = data.description
const publishDate = data.publishDate
const title = data.title
const updatedDate = data.updatedDate
const isDraft = data.draft
const enableComment = data.comment
const heroImage = 'heroImage' in data ? data.heroImage : undefined

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor =
  (heroImage && 'color' in heroImage ? heroImage.color : undefined) ??
  'hsl(var(--primary) / var(--un-text-opacity))'

// Reading time: theme remark (local MD), else post.body (Notion), else words
const minutesFromText = (() => {
  const raw = String(remarkPluginFrontmatter.minutesRead ?? '')
  const m = raw.match(/(\d+)/)
  return m ? Math.max(1, Number(m[1])) : 0
})()
const body =
  typeof (post as { body?: unknown }).body === 'string'
    ? ((post as { body: string }).body)
    : ''
const fromBody = body.trim() ? getReadingTime(body) : null
const minutesFromBody = fromBody ? Math.max(1, Math.ceil(fromBody.minutes)) : 0
const words = Number(remarkPluginFrontmatter.words ?? fromBody?.words ?? 0)
const minutesFromWords = words > 0 ? Math.max(1, Math.ceil(words / 200)) : 0
const minutes = minutesFromText || minutesFromBody || minutesFromWords || 1
const heroFrontmatter = {
  ...remarkPluginFrontmatter,
  minutesRead: `约 ${minutes} 分钟阅读`,
  words
}
---

<ReadingProgress />
<script is:inline>
  // Recalc from rendered #content (Notion body may be empty at remark time)
  ;(function () {
    function isCJK(ch) {
      const c = ch.charCodeAt(0)
      return (c >= 0x4e00 && c <= 0x9fff) || (c >= 0x3400 && c <= 0x4dbf)
    }
    function wordsOf(text) {
      let words = 0
      let inWord = false
      for (let i = 0; i < text.length; i++) {
        const ch = text[i]
        if (isCJK(ch)) {
          words++
          inWord = false
        } else if (/\S/.test(ch)) {
          if (!inWord) {
            words++
            inWord = true
          }
        } else inWord = false
      }
      return words
    }
    function sync() {
      const article = document.getElementById('content')
      if (!article) return
      const n = Math.max(1, Math.ceil(wordsOf(article.innerText || '') / 200))
      const label = '约 ' + n + ' 分钟阅读'
      const info = document.querySelector('.article-info')
      if (!info) return
      const rows = info.querySelectorAll('.flex.items-center.gap-1')
      rows.forEach((row) => {
        const t = (row.textContent || '').trim()
        if (/分钟阅读|\d+\s*min/i.test(t)) {
          const svg = row.querySelector('svg')
          row.textContent = ''
          if (svg) row.appendChild(svg)
          row.appendChild(document.createTextNode(' ' + label))
        }
      })
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', sync)
    else sync()
  })()
</script>

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back='/blog'
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  <Hero data={data as any} remarkPluginFrontmatter={heroFrontmatter} slot='header'>
    <Fragment slot='description'>
      {!isDraft && <PageInfo class='mt-1' />}
    </Fragment>
  </Hero>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright (theme weibo/x/bluesky share) */}
    <Copyright data={data as any} />
    {/* Prev / next — larger cards */}
    <PostNav {posts} {id} class='mt-4 sm:mt-8' />
    {/* Comments: Giscus (Waline disabled) */}
    {!isDraft && enableComment && <Giscus class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{!isDraft && <ShareChina title={title} />}

{config.integ.mediumZoom.enable && <MediumZoom />}
