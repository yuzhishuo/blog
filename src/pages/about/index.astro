---
import { Button, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'hobbies', text: '兴趣' },
  { depth: 2, slug: 'tools', text: '工具' },
  { depth: 2, slug: 'social-networks', text: '社交' },
  { depth: 2, slug: 'about-blog', text: '关于博客' }
]
---

<PageLayout title='关于' {headings} comment>
  <p>Engineering · Linux · Tools</p>
  <p>
    我是 Yi min Liu。写博客主要是为了沉淀工程实践：Linux、Shell、开发工具，以及一些可复现的折腾记录。
  </p>
  <p>Motto: Stay hungry, Stay foolish.</p>
  <Button title='查看项目' class='w-fit' href='/projects' variant='ahead' />

  {/* general-talk */}
  <h2 id='hobbies'>兴趣</h2>
  <ul>
    <li>Linux / Shell：日常环境、脚本与工具链</li>
    <li>前端与静态站点：TypeScript、Astro</li>
    <li>电影、游戏与音乐（豆瓣「看过 · 玩过 · 听过」）</li>
  </ul>

  {/* tools */}
  <h2 id='tools'>工具</h2>
  <p>常用工具（主题模板遗留，后续再精简）：</p>
  <ToolSection
    class='mb-5'
    title='Design'
    tools={[
      {
        name: 'Photoshop',
        description: 'Picture Editing',
        href: 'https://www.adobe.com/products/photoshop',
        icon: import('@/assets/tools/photoshop.svg?raw')
      },
      {
        name: 'Illustrator',
        description: 'Vector Drawing',
        href: 'https://www.adobe.com/products/illustrator',
        icon: import('@/assets/tools/illustrator.svg?raw')
      },
      {
        name: 'After Effects',
        description: 'Motion Graphics',
        href: 'https://www.adobe.com/products/aftereffects',
        icon: import('@/assets/tools/aftereffects.svg?raw')
      },
      {
        name: 'Premiere Pro',
        description: 'Video Editing',
        href: 'https://www.adobe.com/products/premiere',
        icon: import('@/assets/tools/premiere.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Firefox',
        description: 'Browser',
        href: 'https://www.mozilla.org/en-US/firefox',
        icon: import('@/assets/tools/firefox.svg?raw')
      },
      {
        name: 'Notion',
        description: 'Note Taking',
        href: 'https://www.notion.so/',
        icon: import('@/assets/tools/notion.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Neovim',
        description: 'IDE',
        href: 'https://neovim.io/',
        icon: import('@/assets/tools/neovim.svg?raw')
      },
      {
        name: 'Sublime Text',
        description: 'IDE',
        href: 'https://www.sublimetext.com/',
        icon: import('@/assets/tools/sublime.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Arch Linux',
        description: 'Linux Distribution',
        href: 'https://archlinux.org/',
        icon: import('@/assets/tools/archlinux.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'MacOS Tahoe',
        description: 'MacBook Air',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      },
      {
        name: 'Windows 11',
        description: 'Framework Laptop 16',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>社交</h2>
  <p>
    Lorem ipsum dolor sit amet, vidit suscipit at mei. Quem denique mea id. Usu ei regione indoctum
    dissentiunt, cu meliore fuisset mei, vel quod voluptua ne.
  </p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/yuzhishuo',
        text: 'followers',
        api: 'github/yuzhishuo'
      }
    ]}
  />

  {/* about-blog */}
  <h2 id='about-blog'>关于博客</h2>
  <p>本站简史：</p>
  <Timeline
    events={[
      {
        date: '2026-09-11',
        content:
          '基于 <a href="https://github.com/cworld1/astro-theme-pure" target="_blank">Astro Theme Pure</a> 搭建个人工程博客'
      }
    ]}
  />
  <p>站点运行依赖以下项目与服务：</p>
  <ul>
    <li>域名：<a href='https://yuzhishuo.github.io' target='_blank'>yuzhishuo.github.io</a></li>
    <li>
      框架与主题：<a href='https://astro.build/' target='_blank'>Astro</a> +
      <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>Astro Theme Pure</a>
    </li>
    <li>
      站点托管：<a href='https://pages.github.com/' target='_blank'>GitHub Pages</a>
    </li>
    <li>
      CI/CD：<a href='https://github.com/features/actions' target='_blank'>GitHub Actions</a>
    </li>
    <li>评论：Giscus（待配置，Waline 已关闭）</li>
    <li>
      其他统计：<a href='https://github.com/spencerwooo/substats' target='_blank'>Substats</a>
    </li>
  </ul>
</PageLayout>
