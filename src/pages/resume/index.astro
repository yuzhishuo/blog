---
/**
 * Resume uses the same BaseLayout header/footer as the rest of the site
 * so the nav bar does not jump when switching pages.
 */
import PageLayout from '@/layouts/BaseLayout.astro'
import ResumeSheet from '@/components/resume/ResumeSheet.astro'
import raw from '@/data/resume.json'
import type { ResumeData } from '@/lib/resume'

const data = raw as ResumeData
---

<PageLayout meta={{ title: data.name, description: '个人简历（不公开索引）' }}>
  <div class='resume-page-body mx-auto w-full max-w-3xl pb-10 pt-2'>
    <div class='resume-toolbar no-print mb-4 flex justify-end'>
      <button
        type='button'
        id='resume-print-btn'
        class='rounded-lg border border-border bg-transparent px-3 py-1.5 text-sm text-muted-foreground hover:border-foreground/25 hover:text-foreground'
      >
        打印
      </button>
    </div>
    <ResumeSheet data={data} />
  </div>

  <style is:global>
    @page {
      size: A4 portrait;
      margin: 12mm 12mm;
    }

    @media print {
      html,
      body {
        background: #fff !important;
        color: #111 !important;
        height: auto !important;
        min-height: 0 !important;
        overflow: visible !important;
        /* Comfortable Chinese sans for print — avoid Songti/serif */
        font-family:
          'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Microsoft YaHei',
          system-ui, -apple-system, 'Segoe UI', sans-serif !important;
      }

      /* Hide all site chrome — brand「博客」and nav「简历」live here */
      header-component,
      header,
      footer,
      nav,
      .resume-toolbar,
      .no-print,
      #sidebar,
      #sidebar-shade,
      #action-buttons,
      .share-china,
      .share-rail {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        overflow: hidden !important;
      }

      #main-container,
      #main-container > .flex-1,
      .resume-page-body {
        display: block !important;
        width: 100% !important;
        max-width: none !important;
        min-height: 0 !important;
        height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      #resume-sheet,
      #resume-sheet .cv,
      #resume-sheet .cv * {
        font-family:
          'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Microsoft YaHei',
          system-ui, -apple-system, 'Segoe UI', sans-serif !important;
      }

      #resume-sheet {
        page-break-after: avoid !important;
        page-break-inside: avoid !important;
        break-after: avoid-page !important;
        break-inside: avoid-page !important;
      }
    }
  </style>

  <script>
    const screenTitle = document.title
    // Empty title so browser print headers do not show「简历 • 博客」
    const setPrintTitle = () => {
      document.title = '\u200b'
    }
    const restoreTitle = () => {
      document.title = screenTitle
    }

    window.addEventListener('beforeprint', setPrintTitle)
    window.addEventListener('afterprint', restoreTitle)

    document.getElementById('resume-print-btn')?.addEventListener('click', () => {
      setPrintTitle()
      window.print()
      setTimeout(restoreTitle, 800)
    })
  </script>
</PageLayout>
