---
import PageLayout from '@/layouts/CommonPage.astro'
---

<PageLayout title='简历'>
  <p>
    数据源：仓库 <code>resume/resume.json</code>。本机用 Docker 起可视化编辑器改内容，导出 PDF 后本页展示。
  </p>
  <p class='not-prose text-sm text-muted-foreground'>
    启动：<code>docker compose -f docker-compose.resume.yml up -d</code> →
    <a href='http://localhost:3099' target='_blank' rel='noopener'>localhost:3099</a>
  </p>
  <p class='not-prose flex flex-wrap gap-3 text-sm'>
    <a class='rounded-lg border px-3 py-1.5 no-underline hover:border-primary' href='/resume.pdf' target='_blank' rel='noopener'>
      打开 PDF
    </a>
    <a class='rounded-lg border px-3 py-1.5 no-underline hover:border-primary' href='/resume.pdf' download>
      下载 PDF
    </a>
  </p>
  <div class='not-prose mt-4 overflow-hidden rounded-2xl border bg-muted'>
    <iframe title='简历 PDF' src='/resume.pdf' class='h-[min(85vh,56rem)] w-full'></iframe>
  </div>
</PageLayout>
