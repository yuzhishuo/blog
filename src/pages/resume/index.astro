---
import { Header, ThemeProvider } from 'astro-pure/components/basic'
import Footer from '@/components/Footer.astro'
import BaseHead from '@/components/BaseHead.astro'
import ResumeSheet from '@/components/resume/ResumeSheet.astro'
import config from '@/site-config'
import raw from '@/data/resume.json'
import type { ResumeData } from '@/lib/resume'
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

const data = raw as ResumeData
const title = `${data.name} · 简历`
---

<html lang={config.locale.lang} class='resume-page'>
  <head>
    <BaseHead description={`${data.intent} · ${data.city}`} title={title} />
    <ThemeProvider />
    <style is:global>
      @page {
        size: A4;
        margin: 12mm 14mm;
      }

      html.resume-page body {
        background: hsl(var(--background));
      }

      .resume-page-shell {
        width: 100%;
        max-width: 70rem;
        margin: 0 auto;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      .resume-toolbar {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0.75rem 1rem 0;
        padding: 0.7rem 0.9rem;
        border: 1px solid hsl(var(--border));
        border-radius: 1rem;
        background: hsl(var(--background) / 0.92);
        backdrop-filter: blur(10px);
      }

      .resume-toolbar p {
        margin: 0;
        font-size: 0.85rem;
        color: hsl(var(--muted-foreground));
      }

      .resume-toolbar-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .resume-toolbar a,
      .resume-toolbar button {
        display: inline-flex;
        align-items: center;
        border-radius: 0.75rem;
        border: 1px solid hsl(var(--border));
        background: hsl(var(--muted) / 0.45);
        padding: 0.35rem 0.8rem;
        font-size: 0.85rem;
        color: hsl(var(--foreground));
        text-decoration: none;
        cursor: pointer;
      }

      .resume-toolbar button.primary {
        border-color: transparent;
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
      }

      .resume-main {
        flex: 1;
        padding: 1.25rem 1rem 2.5rem;
      }

      /*
        Print: hide ALL site chrome. Only #resume-sheet is visible.
        This is intentional and separate from screen layout.
      */
      @media print {
        html.resume-page,
        html.resume-page body {
          background: #fff !important;
          color: #111 !important;
        }

        html.resume-page body * {
          visibility: hidden !important;
        }

        html.resume-page #resume-sheet,
        html.resume-page #resume-sheet * {
          visibility: visible !important;
        }

        html.resume-page #resume-sheet {
          position: absolute !important;
          inset: 0 auto auto 0 !important;
          width: 100% !important;
          max-width: none !important;
          margin: 0 !important;
          padding: 0 !important;
        }

        .resume-site-chrome,
        .resume-toolbar {
          display: none !important;
        }
      }
    </style>
  </head>

  <body>
    <div class='resume-page-shell'>
      <div class='resume-site-chrome'>
        <Header />
      </div>

      <div class='resume-toolbar resume-site-chrome'>
        <p>简历页独立排版 · 数据 <code>resume/resume.json</code></p>
        <div class='resume-toolbar-actions'>
          <button type='button' class='primary' id='resume-print-btn'>打印（无网页头）</button>
          <a href='/'>回首页</a>
          <a href='/about'>关于</a>
        </div>
      </div>

      <main class='resume-main'>
        <ResumeSheet data={data} />
      </main>

      <div class='resume-site-chrome mx-auto w-full max-w-[70rem] px-4'>
        <Footer />
      </div>
    </div>

    <script>
      document.getElementById('resume-print-btn')?.addEventListener('click', () => window.print())
    </script>
  </body>
</html>
