---
import { Header, ThemeProvider } from 'astro-pure/components/basic'
import Footer from '@/components/Footer.astro'
import BaseHead from '@/components/BaseHead.astro'
import ResumeSheet from '@/components/resume/ResumeSheet.astro'
import config from '@/site-config'
import raw from '@/data/resume.json'
import type { ResumeData } from '@/lib/resume'
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

const data = raw as ResumeData
const title = `${data.name} · 简历`
---

<html lang={config.locale.lang} class='resume-page'>
  <head>
    <BaseHead description={`${data.intent} · ${data.city}`} title={title} />
    <ThemeProvider />
    <style is:global>
      @page {
        size: A4;
        margin: 14mm 16mm;
      }

      .resume-shell {
        width: 100%;
        max-width: 70rem;
        margin: 0 auto;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      .resume-bar {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding: 0.75rem 1rem 0;
      }

      .resume-bar button,
      .resume-bar a {
        border: 1px solid hsl(var(--border));
        background: transparent;
        color: hsl(var(--muted-foreground));
        border-radius: 0.65rem;
        padding: 0.3rem 0.75rem;
        font-size: 0.8rem;
        text-decoration: none;
        cursor: pointer;
      }

      .resume-bar button:hover,
      .resume-bar a:hover {
        color: hsl(var(--foreground));
        border-color: hsl(var(--foreground) / 0.25);
      }

      .resume-main {
        flex: 1;
        padding: 1rem 1.25rem 3rem;
      }

      @media print {
        html.resume-page,
        html.resume-page body {
          background: #fff !important;
        }

        html.resume-page body * {
          visibility: hidden !important;
        }

        html.resume-page #resume-sheet,
        html.resume-page #resume-sheet * {
          visibility: visible !important;
        }

        html.resume-page #resume-sheet {
          position: absolute !important;
          inset: 0 auto auto 0 !important;
          width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
        }

        .resume-site-chrome,
        .resume-bar {
          display: none !important;
        }
      }
    </style>
  </head>

  <body class='bg-background text-foreground'>
    <div class='resume-shell'>
      <div class='resume-site-chrome'>
        <Header />
      </div>

      <div class='resume-bar resume-site-chrome'>
        <a href='/'>首页</a>
        <button type='button' id='resume-print-btn'>打印</button>
      </div>

      <main class='resume-main'>
        <ResumeSheet data={data} />
      </main>

      <div class='resume-site-chrome mx-auto w-full max-w-[70rem] px-4'>
        <Footer />
      </div>
    </div>

    <script>
      document.getElementById('resume-print-btn')?.addEventListener('click', () => window.print())
    </script>
  </body>
</html>
