---
import PageLayout from '@/layouts/CommonPage.astro'
import ResumeSheet from '@/components/resume/ResumeSheet.astro'
import raw from '@/data/resume.json'
import type { ResumeData } from '@/lib/resume'

const data = raw as ResumeData
const headings = [
  { depth: 2, slug: 'education', text: '教育经历' },
  { depth: 2, slug: 'experience', text: '工作经历' },
  { depth: 2, slug: 'skills', text: '专业技能' }
]
---

<PageLayout title='简历' {headings}>
  <div class='no-print mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border bg-muted/40 px-4 py-3 text-sm'>
    <p class='m-0 text-muted-foreground'>
      数据源 <code>resume/resume.json</code> · 与博客同风格 · Ctrl/⌘ + P 打印
    </p>
    <button
      type='button'
      id='resume-print-btn'
      class='rounded-xl border bg-background px-3 py-1.5 text-foreground transition-colors hover:border-primary/40 hover:text-primary'
    >
      打印简历
    </button>
  </div>

  <ResumeSheet data={data} />
</PageLayout>

<style is:global>
  @page {
    size: A4;
    margin: 14mm;
  }

  @media print {
    .no-print,
    header,
    footer,
    #header,
    #sidebar,
    #sidebar-shade,
    #back-to-top,
    nav,
    .back-btn,
    button#sidebar-btn,
    button#share-btn {
      display: none !important;
    }

    #main-container,
    main,
    .flex-1 {
      max-width: none !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      min-height: 0 !important;
    }

    body {
      background: #fff !important;
      color: #111 !important;
    }

    html.has-floating-actions #main-container {
      padding-bottom: 0 !important;
      padding-right: 0 !important;
    }
  }
</style>

<script>
  document.getElementById('resume-print-btn')?.addEventListener('click', () => window.print())
</script>
