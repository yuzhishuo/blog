---
/**
 * Compact 不蒜子 page PV line (optional pages).
 */
import { cn } from 'astro-pure/utils'

interface Props {
  view?: boolean
  comment?: boolean
  class?: string
}

const { class: className, ...props } = Astro.props
---

<p class={cn('m-0 text-xs text-muted-foreground', className)} {...props}>
  阅读 <span id='busuanzi_value_page_pv'>-</span> 次
</p>
