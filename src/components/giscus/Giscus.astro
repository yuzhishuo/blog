---
import { cn } from 'astro-pure/utils'
import { getGiscusConfig, isGiscusReady } from '@/config/giscus'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const cfg = getGiscusConfig()
const ready = isGiscusReady(cfg)
---

{
  ready ? (
    <div id="giscus" class={cn('not-prose giscus-wrap', className)}>
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={cfg.repo}
        data-repo-id={cfg.repoId}
        data-category={cfg.category}
        data-category-id={cfg.categoryId}
        data-mapping={cfg.mapping}
        data-strict={cfg.strict}
        data-reactions-enabled={cfg.reactionsEnabled}
        data-emit-metadata={cfg.emitMetadata}
        data-input-position={cfg.inputPosition}
        data-theme={cfg.theme}
        data-lang={cfg.lang}
        data-loading={cfg.loading}
        crossorigin="anonymous"
        async
      />
    </div>
  ) : (
    <div id="giscus" class={cn('not-prose rounded-lg border border-dashed p-4 text-sm opacity-70', className)}>
      <p>
        评论组件尚未就绪。请在 <code>src/site.config.ts</code> 填写
        <code>repo</code> / <code>repoId</code> / <code>category</code> / <code>categoryId</code>
       （或设置 <code>PUBLIC_GISCUS_*</code>），并将 <code>giscus.enable</code> 设为
        <code>true</code>。详见 SETUP.md。若配置已就绪但仍无评论，请确认已安装
        <a href="https://github.com/apps/giscus" target="_blank" rel="noopener">Giscus GitHub App</a>。
      </p>
    </div>
  )
}
