---
/**
 * Clean editorial resume — fully left-aligned.
 * Name / phone / email / company stay masked until the visitor clicks the eye.
 */
import type { ResolvedInsight, ResumeData } from '@/lib/resume'
import { cn } from 'astro-pure/utils'

interface Props {
  data: ResumeData
  insights?: ResolvedInsight[]
  class?: string
}

const { data, insights = [], class: className } = Astro.props

const maskKeep = (value: string, keepStart = 0, keepEnd = 0) => {
  if (!value) return ''
  if (value.length <= keepStart + keepEnd) return '•'.repeat(Math.max(value.length, 4))
  return (
    value.slice(0, keepStart) +
    '•'.repeat(Math.max(value.length - keepStart - keepEnd, 4)) +
    value.slice(value.length - keepEnd)
  )
}

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

const withBold = (s: string) =>
  escapeHtml(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')

const nameMasked = data.name ? '•'.repeat(Math.max(data.name.length, 2)) : ''
const phoneMasked = data.phone ? maskKeep(data.phone, 3, 2) : ''
const emailMasked = data.email
  ? (() => {
      const [local, domain] = data.email.split('@')
      if (!domain) return maskKeep(data.email, 1, 0)
      const localMask =
        local.length <= 2 ? '•'.repeat(Math.max(local.length, 3)) : local[0] + '•'.repeat(Math.max(local.length - 1, 3))
      return `${localMask}@${domain}`
    })()
  : ''
---

<div class={cn('cv not-prose', className)} id='resume-sheet'>
  <div class='cv-head'>
    <h1 class='cv-name'>
      <span class='cv-secret' data-secret='name'>
        <span class='cv-secret-mask' aria-hidden='true'>{nameMasked}</span>
        <span class='cv-secret-real'>{data.name}</span>
        <button
          type='button'
          class='cv-eye'
          aria-label='显示姓名'
          title='显示姓名'
          data-secret-toggle='name'
        >
          <svg class='cv-eye-on' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
            <path
              fill='currentColor'
              d='M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'
            />
          </svg>
          <svg class='cv-eye-off' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
            <path
              fill='currentColor'
              d='M2.1 3.5 3.5 2.1 21.9 20.5 20.5 21.9l-3.2-3.2A12.6 12.6 0 0 1 12 19c-7 0-10-7-10-7a18.6 18.6 0 0 1 5.1-5.5L2.1 3.5zM12 7a5 5 0 0 1 5 5c0 .7-.1 1.3-.4 1.9l-1.6-1.6a3 3 0 0 0-3.3-3.3L10.1 7.4A4.8 4.8 0 0 1 12 7zm-7.2 5s2.2 4.5 7.2 4.5c.8 0 1.5-.1 2.2-.3l-1.7-1.7A5 5 0 0 1 7.5 9.5L4.8 12z'
            />
          </svg>
        </button>
      </span>
    </h1>
    <p class='cv-line cv-contact-line'>
      {data.age && <span>{data.age}</span>}
      {
        data.phone && (
          <>
            {data.age && <span class='cv-sep'> · </span>}
            <span class='cv-secret' data-secret='phone'>
              <span class='cv-secret-mask' aria-hidden='true'>{phoneMasked}</span>
              <span class='cv-secret-real'>{data.phone}</span>
              <button
                type='button'
                class='cv-eye'
                aria-label='显示电话'
                title='显示电话'
                data-secret-toggle='phone'
              >
                <svg class='cv-eye-on' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                  <path
                    fill='currentColor'
                    d='M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'
                  />
                </svg>
                <svg class='cv-eye-off' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                  <path
                    fill='currentColor'
                    d='M2.1 3.5 3.5 2.1 21.9 20.5 20.5 21.9l-3.2-3.2A12.6 12.6 0 0 1 12 19c-7 0-10-7-10-7a18.6 18.6 0 0 1 5.1-5.5L2.1 3.5zM12 7a5 5 0 0 1 5 5c0 .7-.1 1.3-.4 1.9l-1.6-1.6a3 3 0 0 0-3.3-3.3L10.1 7.4A4.8 4.8 0 0 1 12 7zm-7.2 5s2.2 4.5 7.2 4.5c.8 0 1.5-.1 2.2-.3l-1.7-1.7A5 5 0 0 1 7.5 9.5L4.8 12z'
                  />
                </svg>
              </button>
            </span>
          </>
        )
      }
      {
        data.email && (
          <>
            {(data.age || data.phone) && <span class='cv-sep'> · </span>}
            <span class='cv-secret' data-secret='email'>
              <span class='cv-secret-mask' aria-hidden='true'>{emailMasked}</span>
              <span class='cv-secret-real'>{data.email}</span>
              <button
                type='button'
                class='cv-eye'
                aria-label='显示邮箱'
                title='显示邮箱'
                data-secret-toggle='email'
              >
                <svg class='cv-eye-on' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                  <path
                    fill='currentColor'
                    d='M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'
                  />
                </svg>
                <svg class='cv-eye-off' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                  <path
                    fill='currentColor'
                    d='M2.1 3.5 3.5 2.1 21.9 20.5 20.5 21.9l-3.2-3.2A12.6 12.6 0 0 1 12 19c-7 0-10-7-10-7a18.6 18.6 0 0 1 5.1-5.5L2.1 3.5zM12 7a5 5 0 0 1 5 5c0 .7-.1 1.3-.4 1.9l-1.6-1.6a3 3 0 0 0-3.3-3.3L10.1 7.4A4.8 4.8 0 0 1 12 7zm-7.2 5s2.2 4.5 7.2 4.5c.8 0 1.5-.1 2.2-.3l-1.7-1.7A5 5 0 0 1 7.5 9.5L4.8 12z'
                  />
                </svg>
              </button>
            </span>
          </>
        )
      }
    </p>
    <p class='cv-line'>
      {[data.years, data.city ? `期望城市：${data.city}` : ''].filter(Boolean).join('  ·  ')}
    </p>
  </div>

  {
    data.summary?.length ? (
      <section class='cv-sec' id='summary'>
        <h2>个人简介</h2>
        <div class='cv-summary'>
          {data.summary.map((s) => (
            <p class='cv-summary-p' set:html={withBold(s)} />
          ))}
        </div>
      </section>
    ) : null
  }

  <section class='cv-sec' id='experience'>
    <h2>工作经历</h2>
    {
      data.experience.map((job, idx) => {
        const companyMasked = maskKeep(job.company, 2, 0)
        const key = `company-${idx}`
        return (
          <div class='cv-job'>
            <p class='cv-strong'>
              <span class='cv-secret' data-secret={key}>
                <span class='cv-secret-mask' aria-hidden='true'>
                  {companyMasked}
                </span>
                <span class='cv-secret-real'>{job.company}</span>
                <button
                  type='button'
                  class='cv-eye'
                  aria-label='显示公司'
                  title='显示公司'
                  data-secret-toggle={key}
                >
                  <svg class='cv-eye-on' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                    <path
                      fill='currentColor'
                      d='M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'
                    />
                  </svg>
                  <svg class='cv-eye-off' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                    <path
                      fill='currentColor'
                      d='M2.1 3.5 3.5 2.1 21.9 20.5 20.5 21.9l-3.2-3.2A12.6 12.6 0 0 1 12 19c-7 0-10-7-10-7a18.6 18.6 0 0 1 5.1-5.5L2.1 3.5zM12 7a5 5 0 0 1 5 5c0 .7-.1 1.3-.4 1.9l-1.6-1.6a3 3 0 0 0-3.3-3.3L10.1 7.4A4.8 4.8 0 0 1 12 7zm-7.2 5s2.2 4.5 7.2 4.5c.8 0 1.5-.1 2.2-.3l-1.7-1.7A5 5 0 0 1 7.5 9.5L4.8 12z'
                    />
                  </svg>
                </button>
              </span>
              <span class='cv-date'> · {job.start}–{job.end}</span>
            </p>
            <p class='cv-soft m0'>{job.title}</p>
            <div class='cv-bullets'>
              {job.bullets.map((b) => (
                <p class='cv-bullet'>{b}</p>
              ))}
            </div>
          </div>
        )
      })
    }
  </section>

  {
    data.skills?.length ? (
      <section class='cv-sec' id='skills'>
        <h2>
          专业技能
          <button
            type='button'
            class='cv-print-toggle no-print'
            data-print-hide='skills'
            aria-label='打印时隐藏本节'
            title='打印时隐藏本节'
          >
            <svg class='cv-print-on' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
              <path
                fill='currentColor'
                d='M6 9V3h12v6h-2V5H8v4H6zm14 2a2 2 0 0 1 2 2v5h-4v4H6v-4H2v-5a2 2 0 0 1 2-2h16zM8 17v2h8v-2H8zm10-4.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2z'
              />
            </svg>
            <svg class='cv-print-off' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
              <path
                fill='currentColor'
                d='M3.3 2 2 3.3 6.7 8H4a2 2 0 0 0-2 2v5h4v4h9.7l3 3L20 20.7 3.3 2zM8 17v2h6.7l-2-2H8zm12-4v1.7l-2-2V13h2zm0-2h-4.7l-4-4H18V3H8.7l-2-2H20v8a2 2 0 0 1 2 2v5h-2.7l-2-2H20v-5a2 2 0 0 0-2-2z'
              />
            </svg>
          </button>
        </h2>
        <div class='cv-skills'>
          {data.skills.map((s, i) => (
            <p class='cv-skill' data-print-item={`skill-${i}`}>
              <span class='cv-skill-text'>{s}</span>
              <button
                type='button'
                class='cv-print-toggle no-print'
                data-print-hide={`skill-${i}`}
                aria-label='打印时隐藏此项'
                title='打印时隐藏此项'
              >
                <svg class='cv-print-on' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                  <path
                    fill='currentColor'
                    d='M6 9V3h12v6h-2V5H8v4H6zm14 2a2 2 0 0 1 2 2v5h-4v4H6v-4H2v-5a2 2 0 0 1 2-2h16zM8 17v2h8v-2H8zm10-4.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2z'
                  />
                </svg>
                <svg class='cv-print-off' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
                  <path
                    fill='currentColor'
                    d='M3.3 2 2 3.3 6.7 8H4a2 2 0 0 0-2 2v5h4v4h9.7l3 3L20 20.7 3.3 2zM8 17v2h6.7l-2-2H8zm12-4v1.7l-2-2V13h2zm0-2h-4.7l-4-4H18V3H8.7l-2-2H20v8a2 2 0 0 1 2 2v5h-2.7l-2-2H20v-5a2 2 0 0 0-2-2z'
                  />
                </svg>
              </button>
            </p>
          ))}
        </div>
      </section>
    ) : null
  }

  <section class='cv-sec' id='education'>
    <h2>教育经历</h2>
    <ul class='cv-list'>
      {
        data.education.map((ed) => (
          <li class='cv-item'>
            <p class='cv-strong'>
              {ed.school}
              <span class='cv-soft'>
                {' '}
                {ed.degree} · {ed.major}
              </span>
              <span class='cv-date'> · {ed.start}–{ed.end}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    insights.length ? (
      <section class='cv-sec' id='insights'>
        <h2>
          原创文章
          <button
            type='button'
            class='cv-print-toggle no-print'
            data-print-hide='insights'
            aria-label='打印时隐藏本节'
            title='打印时隐藏本节'
          >
            <svg class='cv-print-on' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
              <path
                fill='currentColor'
                d='M6 9V3h12v6h-2V5H8v4H6zm14 2a2 2 0 0 1 2 2v5h-4v4H6v-4H2v-5a2 2 0 0 1 2-2h16zM8 17v2h8v-2H8zm10-4.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2z'
              />
            </svg>
            <svg class='cv-print-off' viewBox='0 0 24 24' width='14' height='14' aria-hidden='true'>
              <path
                fill='currentColor'
                d='M3.3 2 2 3.3 6.7 8H4a2 2 0 0 0-2 2v5h4v4h9.7l3 3L20 20.7 3.3 2zM8 17v2h6.7l-2-2H8zm12-4v1.7l-2-2V13h2zm0-2h-4.7l-4-4H18V3H8.7l-2-2H20v8a2 2 0 0 1 2 2v5h-2.7l-2-2H20v-5a2 2 0 0 0-2-2z'
              />
            </svg>
          </button>
        </h2>
        <div class='cv-insights'>
          {insights.map((item, i) => (
            <p class='cv-insight'>
              <span class='cv-insight-idx'>{i + 1}. </span>
              <a class='cv-insight-title' href={item.url} target='_blank' rel='noreferrer'>
                {item.title}
              </a>
              {item.extra ? <span class='cv-insight-extra'>({item.extra})</span> : null}
              {item.note ? <span class='cv-insight-note'>: {item.note}</span> : null}
            </p>
          ))}
        </div>
      </section>
    ) : null
  }
</div>

<script>
  const root = document.getElementById('resume-sheet')
  if (root) {
    root.querySelectorAll<HTMLButtonElement>('[data-secret-toggle]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        const key = btn.dataset.secretToggle
        if (!key) return
        const wrap = root.querySelector(`[data-secret="${key}"]`)
        if (!wrap) return
        const shown = wrap.classList.toggle('is-shown')
        btn.setAttribute('aria-label', shown ? '隐藏' : btn.title || '显示')
        btn.setAttribute('aria-pressed', shown ? 'true' : 'false')
      })
    })

    const printHideKey = 'resume-print-hide'
    const printHideTarget = (id: string) =>
      id === 'skills'
        ? root.querySelector('#skills')
        : id === 'insights'
          ? root.querySelector('#insights')
          : root.querySelector(`[data-print-item="${id}"]`)

    const setPrintHidden = (id: string, hidden: boolean) => {
      const el = printHideTarget(id)
      const btn = root.querySelector<HTMLButtonElement>(`[data-print-hide="${id}"]`)
      if (!el || !btn) return
      el.classList.toggle('no-print', hidden)
      el.classList.toggle('is-print-hidden', hidden)
      btn.setAttribute('aria-pressed', hidden ? 'true' : 'false')
      btn.setAttribute('aria-label', hidden ? '打印时显示' : (btn.title || '打印时隐藏'))
    }

    const readPrintHidden = (): string[] => {
      try {
        const raw = localStorage.getItem(printHideKey)
        return raw ? (JSON.parse(raw) as string[]) : []
      } catch {
        return []
      }
    }

    const writePrintHidden = (ids: string[]) => {
      localStorage.setItem(printHideKey, JSON.stringify(ids))
    }

    let hiddenIds = readPrintHidden()
    hiddenIds.forEach((id) => setPrintHidden(id, true))

    root.querySelectorAll<HTMLButtonElement>('[data-print-hide]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        const id = btn.dataset.printHide
        if (!id) return
        const next = !hiddenIds.includes(id)
        hiddenIds = next ? [...hiddenIds, id] : hiddenIds.filter((x) => x !== id)
        setPrintHidden(id, next)
        writePrintHidden(hiddenIds)
      })
    })
  }
</script>

<style>
  .cv {
    max-width: 42rem;
    margin: 0;
    text-align: left;
    color: hsl(var(--foreground));
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .cv-head {
    text-align: left;
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .cv-name .cv-secret {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cv-name {
    margin: 0 0 0.65rem;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-align: left;
  }

  .cv-line {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
    text-align: left;
  }

  .cv-contact-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }

  .cv-secret {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    vertical-align: baseline;
  }

  .cv-secret-real {
    display: none;
  }

  .cv-secret.is-shown .cv-secret-mask {
    display: none;
  }

  .cv-secret.is-shown .cv-secret-real {
    display: inline;
  }

  .cv-eye {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.15rem;
    padding: 0.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .cv-secret:hover .cv-eye,
  .cv-secret:focus-within .cv-eye,
  .cv-secret.is-shown .cv-eye,
  .cv-eye:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .cv-eye:hover {
    color: hsl(var(--primary));
    background: hsl(var(--muted) / 0.55);
  }

  .cv-eye-off {
    display: none;
  }

  .cv-secret.is-shown .cv-eye-on {
    display: none;
  }

  .cv-secret.is-shown .cv-eye-off {
    display: block;
  }

  .cv-links {
    margin: 0.55rem 0 0;
    font-size: 0.875rem;
    text-align: left;
  }

  .cv-links a {
    color: hsl(var(--primary));
    text-decoration: none;
  }

  .cv-links a:hover {
    text-decoration: underline;
  }

  .cv-links .dot {
    margin: 0 0.4rem;
    color: hsl(var(--muted-foreground));
  }

  .cv-sec {
    margin-top: 1.6rem;
    text-align: left;
  }

  .cv-sec > h2 {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.85rem;
    padding-bottom: 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-align: left;
    border-bottom: 1px solid hsl(var(--border));
  }

  .cv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cv-item,
  .cv-job {
    text-align: left;
  }

  .cv-strong {
    margin: 0;
    font-weight: 600;
    text-align: left;
  }

  .cv-soft {
    font-weight: 400;
    color: hsl(var(--muted-foreground));
    font-size: 0.9em;
  }

  .cv-soft.m0 {
    margin: 0.15rem 0 0;
    display: block;
    font-size: 0.875rem;
  }

  .cv-date {
    font-weight: 400;
    font-size: 0.9em;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .cv-job + .cv-job {
    margin-top: 1.15rem;
  }

  .cv-summary {
    margin: 0;
  }

  .cv-summary-p {
    margin: 0;
    text-align: left;
    color: hsl(var(--foreground) / 0.92);
  }

  .cv-summary-p strong {
    font-weight: 700;
  }

  .cv-summary-p + .cv-summary-p {
    margin-top: 0.35rem;
  }

  .cv-bullets,
  .cv-skills {
    margin: 0.45rem 0 0;
    padding: 0 !important;
    list-style: none !important;
    text-align: left;
    color: hsl(var(--foreground) / 0.92);
  }

  .cv-bullet,
  .cv-skill {
    margin: 0;
    padding: 0 !important;
    text-align: left;
    text-indent: 0 !important;
  }

  .cv-bullet {
    position: relative;
    padding-inline-start: 1em !important;
  }

  .cv-skill {
    padding-inline-start: 0 !important;
  }

  .cv-skill {
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .cv-skills {
    counter-reset: cv-skill;
  }

  .cv-skill {
    counter-increment: cv-skill;
  }

  .cv-skill-text {
    flex: 1;
    min-width: 0;
  }

  .cv-skill-text::before {
    content: counter(cv-skill) '. ';
  }

  .cv-insights {
    margin: 0;
  }

  .cv-insight {
    margin: 0;
    text-align: left;
    color: hsl(var(--foreground) / 0.92);
  }

  .cv-insight + .cv-insight {
    margin-top: 0.4rem;
  }

