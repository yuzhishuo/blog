---
/**
 * Blog-fused resume body (JSON → HTML).
 * Screen: normal blog content styles.
 * Print: same structure, chrome hidden by page CSS.
 */
import type { ResumeData } from '@/lib/resume'
import { cn } from 'astro-pure/utils'

interface Props {
  data: ResumeData
  class?: string
}

const { data, class: className } = Astro.props
---

<div class={cn('resume-body not-prose', className)} id='resume-sheet'>
  <header class='resume-intro mb-8 border-b border-border pb-6'>
    <p class='m-0 text-3xl font-medium tracking-wide text-foreground sm:text-4xl'>{data.name}</p>
    <p class='mt-2 m-0 text-sm text-muted-foreground'>
      {[data.age, data.phone, data.email].filter(Boolean).join(' · ')}
    </p>
    <p class='mt-1 m-0 text-sm text-muted-foreground'>
      {[data.years, `求职意向：${data.intent}`, `期望城市：${data.city}`].filter(Boolean).join(' · ')}
    </p>
    {
      (data.github || data.website) && (
        <p class='mt-2 m-0 flex flex-wrap gap-x-3 gap-y-1 text-sm'>
          {data.website && (
            <a class='text-primary hover:underline' href={data.website} target='_blank' rel='noopener'>
              博客
            </a>
          )}
          {data.github && (
            <a
              class='text-primary hover:underline'
              href={`https://github.com/${data.github}`}
              target='_blank'
              rel='noopener'
            >
              GitHub
            </a>
          )}
        </p>
      )
    }
  </header>

  <section class='resume-block mb-8' id='education'>
    <h2 class='mb-4 mt-0 text-xl font-medium text-foreground'>教育经历</h2>
    <ul class='m-0 flex list-none flex-col gap-4 p-0'>
      {
        data.education.map((ed) => (
          <li class='grid gap-1 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-4'>
            <div class='min-w-0'>
              <p class='m-0 font-medium text-foreground'>{ed.school}</p>
              <p class='m-0 text-sm text-muted-foreground'>
                {ed.degree} · {ed.major}
              </p>
            </div>
            <p class='m-0 text-sm tabular-nums text-muted-foreground'>
              {ed.start}–{ed.end}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class='resume-block mb-8' id='experience'>
    <h2 class='mb-4 mt-0 text-xl font-medium text-foreground'>工作经历</h2>
    <div class='flex flex-col gap-6'>
      {
        data.experience.map((job) => (
          <article>
            <div class='grid gap-1 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-4'>
              <div class='min-w-0'>
                <p class='m-0 font-medium text-foreground'>{job.company}</p>
                <p class='m-0 text-sm text-muted-foreground'>{job.title}</p>
              </div>
              <p class='m-0 text-sm tabular-nums text-muted-foreground'>
                {job.start}–{job.end}
              </p>
            </div>
            <ul class='mt-2 mb-0 list-disc space-y-1.5 ps-5 text-sm leading-relaxed text-foreground/90'>
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class='resume-block mb-2' id='skills'>
    <h2 class='mb-4 mt-0 text-xl font-medium text-foreground'>专业技能</h2>
    <ol class='mb-0 list-decimal space-y-2 ps-5 text-sm leading-relaxed text-foreground/90'>
      {data.skills.map((s) => <li>{s}</li>)}
    </ol>
  </section>
</div>

<style>
  @media print {
    .resume-body {
      color: #111 !important;
    }
    .resume-body :global(a) {
      color: #111 !important;
      text-decoration: none !important;
    }
  }
</style>
