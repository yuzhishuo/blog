---
/**
 * Clean editorial resume — minimal, consistent, blog-themed.
 */
import type { ResumeData } from '@/lib/resume'
import { cn } from 'astro-pure/utils'

interface Props {
  data: ResumeData
  class?: string
}

const { data, class: className } = Astro.props
---

<div class={cn('cv not-prose', className)} id='resume-sheet'>
  <header class='cv-head'>
    <h1 class='cv-name'>{data.name}</h1>
    <p class='cv-line'>
      {[data.age, data.phone, data.email].filter(Boolean).join('  ·  ')}
    </p>
    <p class='cv-line'>
      {[data.years, `求职意向：${data.intent}`, `期望城市：${data.city}`]
        .filter(Boolean)
        .join('  ·  ')}
    </p>
    {
      (data.website || data.github) && (
        <p class='cv-links'>
          {data.website && (
            <a href={data.website} target='_blank' rel='noopener'>
              {data.website.replace(/^https?:\/\//, '')}
            </a>
          )}
          {data.github && (
            <>
              {data.website && <span class='dot'>·</span>}
              <a href={`https://github.com/${data.github}`} target='_blank' rel='noopener'>
                GitHub/{data.github}
              </a>
            </>
          )}
        </p>
      )
    }
  </header>

  <section class='cv-sec' id='education'>
    <h2>教育经历</h2>
    <ul class='cv-list'>
      {
        data.education.map((ed) => (
          <li class='cv-row'>
            <div>
              <p class='cv-strong'>
                {ed.school}
                <span class='cv-soft'>
                  {' '}
                  {ed.degree} · {ed.major}
                </span>
              </p>
            </div>
            <span class='cv-date'>
              {ed.start}–{ed.end}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class='cv-sec' id='experience'>
    <h2>工作经历</h2>
    {
      data.experience.map((job) => (
        <div class='cv-job'>
          <div class='cv-row'>
            <div>
              <p class='cv-strong'>{job.company}</p>
              <p class='cv-soft m0'>{job.title}</p>
            </div>
            <span class='cv-date'>
              {job.start}–{job.end}
            </span>
          </div>
          <ul class='cv-bullets'>
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class='cv-sec' id='skills'>
    <h2>专业技能</h2>
    <ol class='cv-skills'>
      {data.skills.map((s) => <li>{s}</li>)}
    </ol>
  </section>
</div>

<style>
  .cv {
    max-width: 42rem;
    margin: 0 auto;
    color: hsl(var(--foreground));
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .cv-head {
    text-align: center;
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .cv-name {
    margin: 0 0 0.65rem;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.25;
  }

  .cv-line {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }

  .cv-links {
    margin: 0.55rem 0 0;
    font-size: 0.875rem;
  }

  .cv-links a {
    color: hsl(var(--primary));
    text-decoration: none;
  }

  .cv-links a:hover {
    text-decoration: underline;
  }

  .cv-links .dot {
    margin: 0 0.4rem;
    color: hsl(var(--muted-foreground));
  }

  .cv-sec {
    margin-top: 1.6rem;
  }

  .cv-sec > h2 {
    margin: 0 0 0.85rem;
    padding-bottom: 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    border-bottom: 1px solid hsl(var(--border));
  }

  .cv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cv-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .cv-strong {
    margin: 0;
    font-weight: 600;
  }

  .cv-soft {
    font-weight: 400;
    color: hsl(var(--muted-foreground));
    font-size: 0.9em;
  }

  .cv-soft.m0 {
    margin: 0.15rem 0 0;
    display: block;
    font-size: 0.875rem;
  }

  .cv-date {
    flex-shrink: 0;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cv-job + .cv-job {
    margin-top: 1.15rem;
  }

  .cv-bullets {
    margin: 0.45rem 0 0;
    padding-inline-start: 1.15rem;
    color: hsl(var(--foreground) / 0.92);
  }

  .cv-bullets li + li {
    margin-top: 0.28rem;
  }

  .cv-skills {
    margin: 0;
    padding-inline-start: 1.2rem;
  }

  .cv-skills li + li {
    margin-top: 0.4rem;
  }

  @media (max-width: 560px) {
    .cv-row {
      flex-direction: column;
      gap: 0.15rem;
    }
    .cv-name {
      letter-spacing: 0.12em;
      font-size: 1.75rem;
    }
  }

  @media print {
    .cv {
      max-width: none;
      color: #111;
      font-size: 9.2pt;
      line-height: 1.35;
    }
    .cv-head {
      border-bottom-color: #bbb;
      margin-bottom: 7pt;
      padding-bottom: 5pt;
      text-align: center;
    }
    .cv-name {
      margin-bottom: 3pt;
      font-size: 16pt;
      letter-spacing: 0.14em;
    }
    .cv-line {
      margin-top: 1pt;
      font-size: 8.5pt;
    }
    .cv-links {
      margin-top: 2pt;
      font-size: 8.5pt;
    }
    .cv-line,
    .cv-soft,
    .cv-date,
    .cv-soft.m0 {
      color: #444;
    }
    .cv-sec {
      margin-top: 7pt;
    }
    .cv-sec > h2 {
      margin-bottom: 4pt;
      padding-bottom: 2pt;
      border-bottom-color: #bbb;
      font-size: 10pt;
    }
    .cv-list {
      gap: 3pt;
    }
    .cv-job + .cv-job {
      margin-top: 5pt;
    }
    .cv-soft.m0 {
      margin-top: 1pt;
      font-size: 8.5pt;
    }
    .cv-date {
      font-size: 8.5pt;
    }
    .cv-bullets {
      margin-top: 2pt;
      padding-inline-start: 12pt;
    }
    .cv-bullets li + li,
    .cv-skills li + li {
      margin-top: 1pt;
    }
    .cv-skills {
      padding-inline-start: 12pt;
    }
    .cv-links a {
      color: #111;
      text-decoration: none;
    }
    .cv-sec,
    .cv-job,
    .cv-head {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>
