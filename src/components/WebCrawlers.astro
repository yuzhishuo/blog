---
/**
 * Spiders already on the page. They do not fetch anything.
 * Eight-leg IK, silk, word highlight. In cyber mode they also
 * carry a HUD, drop/lift on a rope, and rewind petals on exit.
 */
---

<canvas id='web-crawler-bloom' aria-hidden='true'></canvas>
<canvas id='web-crawler-silk' aria-hidden='true'></canvas>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const path = location.pathname.replace(/\/$/, '') || '/'
  const article = document.getElementById('content')

  if (!reduced && article && path !== '/resume') {
    const silk = document.getElementById('web-crawler-silk') as HTMLCanvasElement
    const bloom = document.getElementById('web-crawler-bloom') as HTMLCanvasElement
    const ctx = silk.getContext('2d', { alpha: true, desynchronized: true })
    const btx = bloom.getContext('2d', { alpha: true, desynchronized: true })

    type Line = { x: number; y: number; w: number }
    type Pt = { x: number; y: number }
    type Foot = { x: number; y: number; tx: number; ty: number; hold: Pt | null; swingFrom: Pt | null }
    type Spider = {
      id: number
      feet: Foot[]
      seeded: boolean
      phase: 'wait' | 'drop' | 'move' | 'hold' | 'gather' | 'lift'
      from: Pt
      to: Pt
      t: number
      dur: number
      holdLeft: number
      crawlLeft: number
      wobble: number
      trail: { x: number; y: number; at: number }[]
      pos: Pt
      heading: number
      mark: HTMLDivElement
      sparkAt: number
      lastWordAt: number
      style: number
      tempo: number
      lane: number
      haul: boolean
      haulK: number
      gaitT: number
      bob: number
    }
    type Petal = {
      x: number
      y: number
      vx: number
      vy: number
      rot: number
      rotv: number
      w: number
      h: number
      z: number
      kind: 0 | 1 | 2
      fill: string
      hi: string
      u: number
      owner: number
      rewind: boolean
      age: number
      life: number
      flutter: number
      grounded: boolean
      stuck: boolean
    }

    const L1 = 30
    const L2 = 28
    const slots = [26, 10, -10, -26]
    const ink = '#ff6a1f'
    const PETAL_CAP = 420
    const FOIL = [
      { fill: '#ff3d6e', hi: '#ffe08a' },
      { fill: '#ffd000', hi: '#fff6c2' },
      { fill: '#4ecbff', hi: '#e9fbff' },
      { fill: '#c084fc', hi: '#f5e8ff' },
      { fill: '#ff8a3d', hi: '#ffe2c4' },
      { fill: '#3dffb0', hi: '#dbfff1' },
      { fill: '#ff5ad5', hi: '#ffd8f3' },
      { fill: '#f4f7ff', hi: '#ffffff' }
    ]
    let nextId = 1
    let silkDpr = 1
    let bloomDpr = 1
    function cyberOn(): boolean {
      return document.documentElement.classList.contains('cyber')
    }

    function packCount(): number {
      if (cyberOn()) {
        return window.innerWidth < 520 ? 2 : 3
      }
      return window.innerWidth < 720 ? 1 : 2
    }

    function makeSpider(slot: number): Spider {
      const mark = document.createElement('div')
      mark.className = 'web-crawler-mark'
      mark.setAttribute('aria-hidden', 'true')
      document.body.appendChild(mark)
      const style = slot % 3
      return {
        id: nextId++,
        feet: Array.from({ length: 8 }, () => ({
          x: 0,
          y: 0,
          tx: 0,
          ty: 0,
          hold: null,
          swingFrom: null
        })),
        seeded: false,
        phase: 'wait',
        from: { x: 0, y: 0 },
        to: { x: 0, y: 0 },
        t: 1,
        dur: 0.4,
        holdLeft: 0.35 + slot * 2.7 + Math.random() * 0.5,
        crawlLeft: 0,
        wobble: 0,
        trail: [],
        pos: { x: 0, y: 0 },
        heading: Math.PI / 2,
        mark,
        sparkAt: 0,
        lastWordAt: 0,
        style,
        tempo: [1.28, 0.74, 1.02][style],
        lane: [0.2, 0.5, 0.8][style],
        haul: false,
        haulK: 1,
        gaitT: 0,
        bob: 0
      }
    }

    const spiders: Spider[] = []
    function syncPack() {
      const n = packCount()
      while (spiders.length < n) {
        spiders.push(makeSpider(spiders.length))
      }
      while (spiders.length > n) {
        const s = spiders.pop()
        s?.mark.remove()
      }
    }

    let lines: Line[] = []
    let linesAt = 0
    function linesInView(force = false): Line[] {
      const now = performance.now()
      if (!force && now - linesAt < 180) {
        return lines
      }
      linesAt = now
      const blocks = article.querySelectorAll('p, li, h2, h3, h4, blockquote')
      const out: Line[] = []
      const top = 64
      const bottom = window.innerHeight - 28
      blocks.forEach((el) => {
        if (el.closest('pre, .astro-code, nav, header, footer')) {
          return
        }
        const range = document.createRange()
        range.selectNodeContents(el)
        const rects = range.getClientRects()
        for (let i = 0; i < rects.length; i++) {
          const r = rects[i]
          if (r.width < 72 || r.height < 8) {
            continue
          }
          if (r.bottom < top || r.top > bottom) {
            continue
          }
          out.push({
            x: r.left + 6,
            y: r.top + r.height * 0.55,
            w: Math.max(12, r.width - 12)
          })
        }
      })
      lines = out
      return lines
    }

    function isCjk(ch: string): boolean {
      const c = ch.codePointAt(0) ?? 0
      return (c >= 0x3400 && c <= 0x9fff) || (c >= 0xf900 && c <= 0xfaff)
    }

    let lastFloatKey = ''
    let lastFloatAt = 0

    function floatWord(rect: DOMRect, text: string, now: number) {
      const key = `${text}@${Math.round(rect.left)}:${Math.round(rect.top)}`
      if (key === lastFloatKey || now - lastFloatAt < 320) {
        return
      }
      lastFloatKey = key
      lastFloatAt = now
      // Soft duckweed-like floaters: one main glyph plus a faint twin.
      const n = text.length > 4 ? 1 : 2
      for (let i = 0; i < n; i++) {
        const ghost = document.createElement('span')
        ghost.className = 'cyber-float'
        ghost.textContent = text
        const jitterX = (Math.random() - 0.5) * 10 + i * 6
        const jitterY = (Math.random() - 0.5) * 4
        ghost.style.left = `${rect.left + jitterX}px`
        ghost.style.top = `${rect.top + jitterY}px`
        ghost.style.font = getComputedStyle(article).font
        ghost.style.fontSize = `${Math.max(11, rect.height * (0.88 + i * 0.06))}px`
        ghost.style.lineHeight = `${rect.height}px`
        const driftX = ((Math.random() - 0.5) * 48 + (i ? 12 : -8)).toFixed(1)
        const driftY = (-28 - Math.random() * 34 - i * 8).toFixed(1)
        const sway = ((Math.random() - 0.5) * 22).toFixed(1)
        const ms = (2100 + Math.random() * 900).toFixed(0)
        ghost.style.setProperty('--drift-x', `${driftX}px`)
        ghost.style.setProperty('--drift-y', `${driftY}px`)
        ghost.style.setProperty('--sway', `${sway}px`)
        ghost.style.setProperty('--float-ms', `${ms}ms`)
        if (i > 0) {
          ghost.style.opacity = '0.55'
          ghost.style.filter = 'blur(0.6px)'
        }
        ghost.addEventListener('animationend', () => {
          ghost.remove()
        })
        document.body.appendChild(ghost)
        // Fallback if animationend never fires (tab hide / cyber toggle).
        window.setTimeout(() => {
          if (ghost.parentNode) {
            ghost.remove()
          }
        }, Number(ms) + 80)
      }
    }

    function wordAt(x: number, y: number): { rect: DOMRect; text: string } | null {
      let node: Node | null | undefined
      let offset = 0
      const pos = document.caretPositionFromPoint?.(x, y)
      if (pos?.offsetNode) {
        node = pos.offsetNode
        offset = pos.offset
      } else {
        const rangeAt = (
          document as Document & {
            caretRangeFromPoint?: (x: number, y: number) => Range | null
          }
        ).caretRangeFromPoint?.(x, y)
        if (rangeAt?.startContainer) {
          node = rangeAt.startContainer
          offset = rangeAt.startOffset
        }
      }
      if (!node || node.nodeType !== Node.TEXT_NODE || !article.contains(node)) {
        return null
      }
      const text = node.textContent ?? ''
      if (!text[offset] && !text[offset - 1]) {
        return null
      }
      const here = text[offset] ?? text[offset - 1] ?? ''
      let a = Math.min(offset, text.length - 1)
      let b = a + 1
      if (isCjk(here)) {
        a = Math.max(0, a)
        b = Math.min(text.length, a + 2)
      } else {
        while (a > 0 && /\S/.test(text[a - 1] ?? '')) {
          a--
        }
        while (b < text.length && /\S/.test(text[b] ?? '')) {
          b++
        }
      }
      if (b - a < 1) {
        return null
      }
      const range = document.createRange()
      range.setStart(node, a)
      range.setEnd(node, b)
      const rect = range.getBoundingClientRect()
      if (rect.width < 2) {
        return null
      }
      return { rect, text: text.slice(a, b) }
    }

    const petals: Petal[] = []

    function resizeSilk() {
      silkDpr = Math.min(window.devicePixelRatio || 1, 1.5)
      bloomDpr = Math.min(window.devicePixelRatio || 1, 1.25) * 0.72
      silk.width = Math.floor(window.innerWidth * silkDpr)
      silk.height = Math.floor(window.innerHeight * silkDpr)
      silk.style.width = `${window.innerWidth}px`
      silk.style.height = `${window.innerHeight}px`
      bloom.width = Math.floor(window.innerWidth * bloomDpr)
      bloom.height = Math.floor(window.innerHeight * bloomDpr)
      bloom.style.width = `${window.innerWidth}px`
      bloom.style.height = `${window.innerHeight}px`
      ctx?.setTransform(silkDpr, 0, 0, silkDpr, 0, 0)
      btx?.setTransform(bloomDpr, 0, 0, bloomDpr, 0, 0)
    }

    function clamp(n: number, lo: number, hi: number): number {
      return Math.min(hi, Math.max(lo, n))
    }

    function ease(u: number): number {
      return u * u * (3 - 2 * u)
    }

    function ropePoint(sky: Pt, end: Pt, u: number, now: number): Pt {
      const sway = Math.sin(now / 240 + sky.x * 0.015) * 16 * u * (1 - u) * 4
      return {
        x: sky.x + (end.x - sky.x) * u + sway,
        y: sky.y + (end.y - sky.y) * u
      }
    }

    function spiderById(id: number): Spider | undefined {
      for (let i = 0; i < spiders.length; i++) {
        if (spiders[i].id === id) {
          return spiders[i]
        }
      }
      return undefined
    }

    function paintOf(i: number): { fill: string; hi: string } {
      return FOIL[i & 7]
    }

    function trimPetals() {
      if (petals.length <= PETAL_CAP) {
        return
      }
      const grounded: Petal[] = []
      const flying: Petal[] = []
      const reeling: Petal[] = []
      for (let i = 0; i < petals.length; i++) {
        const p = petals[i]
        if (p.rewind) {
          reeling.push(p)
        } else if (p.grounded) {
          grounded.push(p)
        } else {
          flying.push(p)
        }
      }
      // Keep younger rewind petals; failed old reels must not pin the CAP.
      reeling.sort((a, b) => a.age - b.age)
      const keep: Petal[] = []
      for (const list of [grounded, flying, reeling]) {
        for (let i = 0; i < list.length && keep.length < PETAL_CAP; i++) {
          keep.push(list[i])
        }
      }
      petals.length = 0
      petals.push(...keep)
    }

    function explodeAlongRope(
      owner: Spider,
      sky: Pt,
      end: Pt,
      now: number,
      count: number
    ) {
      for (let i = 0; i < count; i++) {
        const u = Math.random()
        // Bias toward mid-rope so the bloom reads as a wide burst, not only at the tip.
        const uu = Math.min(1, Math.max(0, u * 0.85 + 0.08))
        const origin = ropePoint(sky, end, uu, now)
        const z = 0.12 + Math.random() * 0.95
        // Full radial burst — petals spray left/right/up/down.
        const a = Math.random() * Math.PI * 2
        const burst = 220 + z * 420 + Math.random() * 180
        const kind = (Math.random() < 0.55 ? 0 : Math.random() < 0.5 ? 1 : 2) as 0 | 1 | 2
        const paint = paintOf(i + owner.id * 3)
        const ribbon = kind === 0
        const outward = 0.75 + Math.random() * 0.55
        petals.push({
          x: origin.x + (Math.random() - 0.5) * 18,
          y: origin.y + (Math.random() - 0.5) * 12,
          vx: Math.cos(a) * burst * outward,
          vy: Math.sin(a) * burst * outward * 0.72 + 40 + Math.random() * 120,
          rot: a,
          rotv: (Math.random() - 0.5) * (ribbon ? 18 : 12),
          w: ribbon ? 34 + z * 42 : kind === 1 ? 11 + z * 12 : 8 + z * 10,
          h: ribbon ? 3.2 + z * 2.2 : kind === 1 ? 11 + z * 10 : 8 + z * 8,
          z,
          kind,
          fill: paint.fill,
          hi: paint.hi,
          u: uu,
          owner: owner.id,
          rewind: false,
          age: 0,
          life: 5.2 + z * 2.0,
          flutter: Math.random() * Math.PI * 2,
          grounded: false,
          stuck: false
        })
      }
      trimPetals()
    }

    function blankPad(): { left: number; right: number; top: number; bottom: number } {
      return {
        left: 28,
        right: window.innerWidth - 28,
        top: 72,
        bottom: window.innerHeight - 36
      }
    }

    // Crawl open canvas (margins / gaps), not only text lines.
    function pickBlank(self: Spider, preferLower = Math.random() < 0.67): Pt {
      const pad = blankPad()
      const cut = window.innerHeight * (2 / 3)
      let best = {
        x: window.innerWidth * self.lane,
        y: preferLower ? cut + 40 : cut - 40
      }
      for (let n = 0; n < 10; n++) {
        const x = clamp(
          window.innerWidth * self.lane + (Math.random() - 0.5) * window.innerWidth * 0.55,
          pad.left,
          pad.right
        )
        const yLo = preferLower ? Math.max(pad.top, cut) : pad.top
        const yHi = preferLower ? pad.bottom : Math.min(pad.bottom, cut)
        const y = yLo + Math.random() * Math.max(8, yHi - yLo)
        const pt = { x, y }
        if (!tooClose(pt.x, pt.y, self)) {
          return pt
        }
        best = pt
      }
      return best
    }

    function pickLine(view: Line[], preferLower = Math.random() < 0.67, lane = 0.5): Line {
      const cut = window.innerHeight * (2 / 3)
      const pool = view.filter((l) => (preferLower ? l.y >= cut : l.y < cut))
      const use = pool.length ? pool : view
      const want = window.innerWidth * lane
      const ranked = [...use].sort(
        (a, b) => Math.abs(a.x + a.w / 2 - want) - Math.abs(b.x + b.w / 2 - want)
      )
      const near = ranked.slice(0, Math.max(3, Math.ceil(ranked.length * 0.45)))
      return near[Math.floor(Math.random() * near.length)]
    }

    function tooClose(x: number, y: number, self: Spider): boolean {
      for (let i = 0; i < spiders.length; i++) {
        const o = spiders[i]
        if (o === self || o.phase === 'wait') {
          continue
        }
        if (Math.hypot(o.pos.x - x, o.pos.y - y) < 86) {
          return true
        }
      }
      return false
    }

    function ropeBusy(self: Spider): boolean {
      for (let i = 0; i < spiders.length; i++) {
        const o = spiders[i]
        if (o === self) {
          continue
        }
        if (o.phase === 'drop' || o.phase === 'lift') {
          return true
        }
      }
      return false
    }

    function pickLand(view: Line[], self: Spider): Pt {
      const preferLower = self.style === 2 ? Math.random() < 0.86 : Math.random() < 0.62
      // Sometimes drop onto open space so ropes aren't always glued to text.
      if (!view.length || Math.random() < 0.38) {
        return pickBlank(self, preferLower)
      }
      let best = { x: self.lane * window.innerWidth, y: window.innerHeight * 0.75 }
      for (let n = 0; n < 8; n++) {
        const line = pickLine(view, preferLower, self.lane)
        const x = clamp(
          line.x + line.w * (0.15 + Math.random() * 0.7),
          line.x + 10,
          line.x + line.w - 10
        )
        const pt = { x, y: line.y }
        if (!tooClose(pt.x, pt.y, self)) {
          return pt
        }
        best = pt
      }
      return best
    }

    function beginDrop(s: Spider, view: Line[]) {
      const land = pickLand(view, s)
      s.from = { x: land.x + (Math.random() - 0.5) * 28, y: 4 }
      s.to = land
      s.pos = { ...s.from }
      s.t = 0
      s.dur = [0.72, 1.38, 1.02][s.style] + Math.random() * 0.18
      s.phase = 'drop'
      s.heading = Math.PI / 2
      explodeAlongRope(s, s.from, s.to, performance.now(), 120 + s.style * 28)
    }

    function beginLift(s: Spider) {
      s.from = { x: s.pos.x, y: s.pos.y }
      s.to = { x: s.pos.x + (Math.random() - 0.5) * 18, y: 4 }
      s.t = 0
      s.dur = [2.6, 3.5, 3.0][s.style]
      s.phase = 'lift'
      s.heading = -Math.PI / 2
      s.haul = false
      s.haulK = 1
      for (let i = 0; i < petals.length; i++) {
        const p = petals[i]
        if (p.owner !== s.id) {
          continue
        }
        p.rewind = true
        p.grounded = false
        p.stuck = false
        p.age = 0
        p.vx *= 0.25
        p.vy = Math.min(30, p.vy * 0.15)
      }
    }

    // Pause under a vertical rope and reel this spider's petals back before lifting.
    function beginGather(s: Spider) {
      s.from = { x: s.pos.x, y: s.pos.y }
      s.to = { x: s.pos.x, y: 4 }
      s.t = 0
      s.dur = [0.9, 1.4, 1.1][s.style]
      s.phase = 'gather'
      s.heading = -Math.PI / 2
      s.bob = 0
      for (let i = 0; i < petals.length; i++) {
        const p = petals[i]
        if (p.owner !== s.id) {
          continue
        }
        p.rewind = true
        p.grounded = false
        p.stuck = false
        p.age = 0
        p.vx *= 0.25
        p.vy = Math.min(30, p.vy * 0.15)
      }
    }

    function ropeSamples(sky: Pt, end: Pt, now: number, n = 26): Pt[] {
      const dx = end.x - sky.x
      const dy = end.y - sky.y
      const len = Math.hypot(dx, dy) || 1
      const px = -dy / len
      const py = dx / len
      const pts: Pt[] = []
      for (let i = 0; i <= n; i++) {
        const u = i / n
        const base = ropePoint(sky, end, u, now)
        const twist = Math.sin(u * 16 + now / 200) * (0.9 + 6 * u * (1 - u))
        pts.push({ x: base.x + px * twist, y: base.y + py * twist })
      }
      return pts
    }

    function strokeRope(c: CanvasRenderingContext2D, pts: Pt[], width: number, color: string) {
      if (pts.length < 2) {
        return
      }
      c.strokeStyle = color
      c.lineWidth = width
      c.lineCap = 'round'
      c.lineJoin = 'round'
      c.beginPath()
      c.moveTo(pts[0].x, pts[0].y)
      for (let i = 1; i < pts.length; i++) {
        c.lineTo(pts[i].x, pts[i].y)
      }
      c.stroke()
    }

    function drawRope(sky: Pt, end: Pt, now: number) {
      if (!ctx) {
        return
      }
      const pts = ropeSamples(sky, end, now)
      strokeRope(ctx, pts, 3.2, 'rgba(255, 150, 70, 0.18)')
      strokeRope(ctx, pts, 1.25, 'rgba(255, 228, 190, 0.95)')
      const hi: Pt[] = pts.map((p, i) => ({
        x: p.x - 0.7,
        y: p.y - 0.35 + Math.sin(i * 0.7) * 0.2
      }))
      strokeRope(ctx, hi, 0.45, 'rgba(255, 255, 255, 0.72)')
    }

    function homeFor(p: Petal, now: number): Pt | null {
      const s = spiderById(p.owner)
      if (!s) {
        return null
      }
      if (s.phase === 'lift') {
        return ropePoint(s.to, s.pos, p.u, now)
      }
      if (s.phase === 'drop') {
        return ropePoint(s.from, s.to, p.u, now)
      }
      return ropePoint({ x: s.pos.x, y: 4 }, s.pos, p.u, now)
    }

    function stepPetals(dt: number, now: number) {
      const floorBase = window.innerHeight - 8
      let w = 0
      for (let i = 0; i < petals.length; i++) {
        const p = petals[i]
        if (p.rewind) {
          p.age += dt
          // Force-drop stuck or timed-out reels so they cannot pin PETAL_CAP.
          if (p.age > Math.min(p.life, 3.2)) {
            continue
          }
          const home = homeFor(p, now)
          if (!home) {
            continue
          }
          const pull = 3.1 + p.z * 1.05
          p.vx += (home.x - p.x) * pull * dt
          p.vy += (home.y - p.y) * pull * dt
          p.vx *= 1 - 2.4 * dt
          p.vy *= 1 - 2.4 * dt
          p.x += p.vx * dt
          p.y += p.vy * dt
          p.rot += p.rotv * dt * 0.9
          const dx = p.x - home.x
          const dy = p.y - home.y
          if (dx * dx + dy * dy < 900) {
            // Absorbed into the rope — remove (do not keep forever).
            continue
          }
        } else {
          p.age += dt
          const rest = floorBase - p.z * 20
          if (!p.grounded) {
            p.vy += (780 + p.z * 240) * dt
            p.vx += Math.sin(now * 0.007 + p.flutter) * (90 + p.z * 110) * dt
            p.vx *= 1 - 0.5 * dt
            p.x += p.vx * dt
            p.y += p.vy * dt
            p.rot += p.rotv * dt
            if (p.y >= rest) {
              p.y = rest
              if (p.vy > 90) {
                p.vy *= -0.16
              } else {
                p.vy = 0
                p.grounded = true
                p.rotv *= 0.2
              }
            }
          } else {
            p.vx += Math.sin(now * 0.003 + p.flutter) * 18 * dt
            p.vx *= 1 - 2.8 * dt
            p.x += p.vx * dt
            p.y = rest
            p.rot += p.rotv * dt
            p.rotv *= 1 - 2.2 * dt
          }
          if (p.x < 6) {
            p.x = 6
            p.vx = Math.abs(p.vx) * 0.4
          } else if (p.x > window.innerWidth - 6) {
            p.x = window.innerWidth - 6
            p.vx = -Math.abs(p.vx) * 0.4
          }
        }
        petals[w++] = p
      }
      petals.length = w
    }

    function drawBloom(now: number) {
      if (!btx) {
        return
      }
      btx.setTransform(1, 0, 0, 1, 0, 0)
      btx.clearRect(0, 0, bloom.width, bloom.height)
      btx.setTransform(bloomDpr, 0, 0, bloomDpr, 0, 0)
      btx.lineCap = 'round'
      for (let i = 0; i < spiders.length; i++) {
        const s = spiders[i]
        if (s.phase !== 'drop' && s.phase !== 'lift' && s.phase !== 'gather') {
          continue
        }
        const sky = s.phase === 'drop' ? s.from : s.to
        const pts = ropeSamples(sky, s.pos, now, 18)
        if (btx) {
          strokeRope(btx, pts, 8, 'rgba(255, 160, 80, 0.16)')
        }
      }
      for (let i = 0; i < petals.length; i++) {
        const p = petals[i]
        const live = 0.72 + p.z * 0.28
        btx.globalAlpha = live
        btx.save()
        btx.translate(p.x, p.y)
        btx.rotate(p.rot)
        if (p.kind === 0) {
          const wave = Math.sin(p.rot * 1.4) * (p.h * 2.2)
          const flip = 0.35 + 0.65 * Math.abs(Math.cos(p.rot * 0.7))
          btx.lineCap = 'round'
          btx.strokeStyle = p.fill
          btx.lineWidth = p.h * flip
          btx.beginPath()
          btx.moveTo(-p.w / 2, 0)
          btx.quadraticCurveTo(0, wave, p.w / 2, -wave * 0.35)
          btx.stroke()
          btx.strokeStyle = p.hi
          btx.lineWidth = Math.max(0.6, p.h * 0.35 * flip)
          btx.beginPath()
          btx.moveTo(-p.w / 2.4, -0.4)
          btx.quadraticCurveTo(0, wave * 0.7, p.w / 2.6, -wave * 0.25)
          btx.stroke()
        } else if (p.kind === 1) {
          const flip = Math.max(0.18, Math.abs(Math.cos(p.rot)))
          btx.scale(1, flip)
          btx.fillStyle = p.fill
          btx.beginPath()
          if (btx.roundRect) {
            btx.roundRect(-p.w / 2, -p.h / 2, p.w, p.h, 1.4)
          } else {
            btx.rect(-p.w / 2, -p.h / 2, p.w, p.h)
          }
          btx.fill()
          btx.fillStyle = p.hi
          btx.globalAlpha = live * 0.55
          btx.fillRect(-p.w / 2, -p.h / 2, p.w * 0.45, p.h * 0.4)
        } else {
          btx.fillStyle = p.fill
          btx.beginPath()
          btx.ellipse(0, 0, p.w * 0.5, p.h * 0.42, 0, 0, Math.PI * 2)
          btx.fill()
          btx.fillStyle = p.hi
          btx.beginPath()
          btx.ellipse(-p.w * 0.14, -p.h * 0.12, p.w * 0.16, p.h * 0.12, 0, 0, Math.PI * 2)
          btx.fill()
        }
        btx.restore()
      }
      btx.globalAlpha = 1
    }

    // Alternating tetrapod: L1/L3/R2/R4 vs R1/L2/R3/L4.
    function tetrapodGroup(i: number): number {
      return (i % 4 + Math.floor(i / 4)) % 2
    }

    // +1 = toward screen bottom (nearer to camera in top-front view).
    function sideNear(heading: number, side: number): number {
      return Math.sin(heading + Math.PI / 2) * side
    }

    // Blend lateral + fore/aft so depth still reads when facing straight down/up.
    function legNear(i: number, heading: number): number {
      const along = slots[i % 4]
      const side = i < 4 ? -1 : 1
      const lat = sideNear(heading, side)
      const fwd = Math.sin(heading) * (along / 26)
      return clamp(lat * 0.72 + fwd * 0.48, -1, 1)
    }

    function aimFor(i: number, hip: Pt, heading: number, reach: Pt | null): Pt {
      const along = slots[i % 4]
      const side = i < 4 ? -1 : 1
      const perp = heading + Math.PI / 2
      const near = legNear(i, heading)
      // Far legs foreshorten inward; near legs plant wider and a bit lower.
      const lat = 34 * (0.78 + near * 0.22)
      const drop = near * 5.2
      if (reach && along > 0) {
        return {
          x: reach.x + Math.cos(perp) * side * (9 + near * 2),
          y: reach.y + Math.sin(perp) * side * (9 + near * 2) + drop * 0.35
        }
      }
      return {
        x: hip.x + Math.cos(heading) * along + Math.cos(perp) * side * lat,
        y: hip.y + Math.sin(heading) * along + Math.sin(perp) * side * lat + drop
      }
    }

    function stepFeet(s: Spider, now: number, dt: number, reach: Pt | null, moving: boolean) {
      // ~2.2 tetrapod cycles/sec at tempo 1; swing short, stance long.
      const rate = 2.15 * s.tempo
      if (moving) {
        s.gaitT += dt * rate
      }
      const swingFrac = 0.3
      for (let i = 0; i < s.feet.length; i++) {
        const foot = s.feet[i]
        const near = legNear(i, s.heading)
        const group = tetrapodGroup(i)
        const phase = (s.gaitT + group * 0.5) % 1
        const aim = aimFor(i, s.pos, s.heading, reach)
        if (!s.seeded) {
          foot.x = aim.x
          foot.y = aim.y
          foot.tx = aim.x
          foot.ty = aim.y
          foot.hold = { x: aim.x, y: aim.y }
          foot.swingFrom = null
          continue
        }
        const swinging = moving && phase < swingFrac
        if (swinging) {
          const u = phase / swingFrac
          if (!foot.swingFrom) {
            foot.swingFrom = foot.hold
              ? { x: foot.hold.x, y: foot.hold.y }
              : { x: foot.x, y: foot.y }
          }
          foot.hold = null
          const sm = u * u * (3 - 2 * u)
          const lift = Math.sin(u * Math.PI)
          // Arc toward new plant; lift toward screen-up; mid-swing tuck slightly in.
          const hx = s.pos.x
          const hy = s.pos.y
          const midX = foot.swingFrom.x + (aim.x - foot.swingFrom.x) * sm
          const midY = foot.swingFrom.y + (aim.y - foot.swingFrom.y) * sm
          const tuck = lift * 0.18
          foot.tx = midX + (hx - midX) * tuck
          foot.ty = midY + (hy - midY) * tuck - lift * (8.5 + near * 2.2)
          const k = 20
          foot.x += (foot.tx - foot.x) * Math.min(1, dt * k)
          foot.y += (foot.ty - foot.y) * Math.min(1, dt * k)
        } else if (moving) {
          // Stance: plant firmly in world space — do not skate with the body.
          foot.swingFrom = null
          if (!foot.hold) {
            foot.hold = { x: foot.x, y: foot.y }
          }
          foot.tx = foot.hold.x
          foot.ty = foot.hold.y
          foot.x = foot.hold.x
          foot.y = foot.hold.y
        } else {
          // Idle / hold / rope: settle all feet onto stance aims.
          foot.swingFrom = null
          foot.hold = { x: aim.x, y: aim.y }
          foot.tx = aim.x
          foot.ty = aim.y
          const k = 10
          foot.x += (foot.tx - foot.x) * Math.min(1, dt * k)
          foot.y += (foot.ty - foot.y) * Math.min(1, dt * k)
        }
      }
      s.seeded = true
      if (moving) {
        // Body bob peaks as each tetrapod plants (twice per gait cycle).
        s.bob = Math.sin(s.gaitT * Math.PI * 2) * 2.35
      } else {
        s.bob *= Math.max(0, 1 - dt * 6)
      }
    }

    function drawLeg(hip: Pt, foot: Foot, sideSign: number, near: number) {
      if (!ctx) {
        return
      }
      const dx = foot.x - hip.x
      const dy = foot.y - hip.y
      const dist = Math.max(1, Math.hypot(dx, dy))
      // Far legs foreshorten; near legs read longer/thicker.
      const depth = 0.8 + near * 0.2
      const d = Math.min(dist, L1 + L2 - 0.2) * (0.9 + near * 0.06)
      const ang = Math.atan2(dy, dx)
      const cosA = clamp((L1 * L1 + d * d - L2 * L2) / (2 * L1 * d), -1, 1)
      const bend = Math.acos(cosA) * sideSign
      const kneeX = hip.x + Math.cos(ang + bend) * L1 * depth
      const kneeY = hip.y + Math.sin(ang + bend) * L1 * depth
      const planted = !!foot.hold
      ctx.strokeStyle = ink
      ctx.fillStyle = ink
      ctx.globalAlpha = 0.72 + near * 0.22
      ctx.lineWidth = 1.35 + near * 0.75
      ctx.beginPath()
      ctx.moveTo(hip.x, hip.y)
      ctx.lineTo(kneeX, kneeY)
      ctx.lineTo(foot.x, foot.y)
      ctx.stroke()
      // Planted pad flat; airborne tip round. Near feet draw larger.
      const pad = 2.0 + near * 0.7
      ctx.beginPath()
      if (planted) {
        ctx.ellipse(foot.x, foot.y, pad * 1.55, pad * 0.72, ang, 0, Math.PI * 2)
      } else {
        ctx.arc(foot.x, foot.y, pad * 0.95, 0, Math.PI * 2)
      }
      ctx.fill()
      ctx.globalAlpha = 1
    }

    function drawBody(hip: Pt, heading: number, bob: number) {
      if (!ctx) {
        return
      }
      const x = hip.x
      const y = hip.y + bob
      // Soft ground shadow — reads as height above the page.
      ctx.save()
      ctx.globalAlpha = 0.2
      ctx.translate(x + Math.cos(heading + Math.PI / 2) * 1.2, y + 6.5)
      ctx.rotate(heading)
      ctx.fillStyle = '#000'
      ctx.beginPath()
      ctx.ellipse(0, 0, 15.5, 5.8, 0, 0, Math.PI * 2)
      ctx.fill()
      ctx.restore()

      ctx.save()
      ctx.translate(x, y)
      ctx.rotate(heading)
      // Mild top-down squash so the oval isn't a flat sticker.
      ctx.scale(1, 0.86)
      ctx.fillStyle = ink
      // Abdomen: rounder / bulkier, sits rear of heading.
      ctx.beginPath()
      ctx.ellipse(-9.2, 0, 11.5, 7.8, 0, 0, Math.PI * 2)
      ctx.fill()
      // Cephalothorax: smaller, then a tiny tip so it reads pointier forward.
      ctx.beginPath()
      ctx.ellipse(6.4, 0, 4.9, 3.55, 0, 0, Math.PI * 2)
      ctx.fill()
      ctx.beginPath()
      ctx.ellipse(10.4, 0, 2.35, 1.65, 0, 0, Math.PI * 2)
      ctx.fill()
      ctx.restore()
    }

    function drawHud(x: number, y: number, now: number) {
      if (!ctx) {
        return
      }
      const w = 132
      const h = 78
      const left = x - w / 2
      const top = y - h / 2
      const arm = 14
      ctx.save()
      ctx.strokeStyle = 'rgba(255, 106, 31, 0.9)'
      ctx.lineWidth = 1.25
      const corners: [number, number, number, number][] = [
        [left, top, 1, 1],
        [left + w, top, -1, 1],
        [left, top + h, 1, -1],
        [left + w, top + h, -1, -1]
      ]
      for (const [cx, cy, sx, sy] of corners) {
        ctx.beginPath()
        ctx.moveTo(cx, cy + sy * arm)
        ctx.lineTo(cx, cy)
        ctx.lineTo(cx + sx * arm, cy)
        ctx.stroke()
      }
      ctx.strokeStyle = 'rgba(255, 106, 31, 0.16)'
      ctx.lineWidth = 1
      ctx.beginPath()
      for (let i = 1; i < 4; i++) {
        const gy = top + (h * i) / 4
        ctx.moveTo(left, gy)
        ctx.lineTo(left + w, gy)
      }
      ctx.stroke()
      const scan = top + ((now / 16) % h)
      ctx.strokeStyle = 'rgba(255, 160, 70, 0.55)'
      ctx.beginPath()
      ctx.moveTo(left, scan)
      ctx.lineTo(left + w, scan)
      ctx.stroke()
      ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace'
      ctx.fillStyle = 'rgba(255, 150, 70, 0.92)'
      ctx.textAlign = 'left'
      ctx.fillText('GAIT  STAGGERED 8-LEG', left, top - 8)
      ctx.fillText(`ATTRACTOR  (${Math.round(x)}, ${Math.round(y)})`, left, top + h + 14)
      ctx.restore()
    }

    function beginMove(s: Spider, view: Line[]) {
      const preferLower =
        s.style === 2 ? Math.random() < 0.84 : s.style === 0 ? Math.random() < 0.48 : Math.random() < 0.62
      const pad = blankPad()
      if (s.pos.x === 0 && s.pos.y === 0) {
        if (view.length && Math.random() < 0.7) {
          const line = pickLine(view, preferLower, s.lane)
          s.pos = {
            x: clamp(line.x + line.w * s.lane, line.x + 10, line.x + line.w - 10),
            y: line.y
          }
        } else {
          s.pos = pickBlank(s, preferLower)
        }
      }
      let tx = s.pos.x
      let ty = s.pos.y
      // Prefer open space sometimes; always use blank when no text lines are in view.
      const wantBlank = !view.length || Math.random() < 0.42
      if (wantBlank) {
        const blank = pickBlank(s, preferLower)
        tx = blank.x
        ty = blank.y
      } else {
        const cut = window.innerHeight * (2 / 3)
        const band = view.filter((l) => (preferLower ? l.y >= cut : l.y < cut))
        const pool0 = band.length ? band : view
        const vertical = pool0.filter((l) => Math.abs(l.y - s.pos.y) > 22)
        const climbChance = [0.9, 0.42, 0.7][s.style]
        const climb = Math.random() < climbChance && vertical.length > 0
        if (climb) {
          const dir =
            s.style === 2
              ? Math.random() < 0.72
                ? 1
                : -1
              : s.style === 0
                ? Math.random() < 0.5
                  ? 1
                  : -1
                : Math.random() < 0.4
                  ? 1
                  : -1
          let pool = vertical.filter(
            (l) => Math.sign(l.y - s.pos.y) === dir || l.y === s.pos.y
          )
          if (!pool.length) {
            pool = vertical
          }
          const want = window.innerWidth * s.lane
          pool = [...pool].sort(
            (a, b) =>
              Math.abs(a.y - s.pos.y) * 0.6 +
              Math.abs(a.x + a.w / 2 - want) * 0.4 -
              (Math.abs(b.y - s.pos.y) * 0.6 + Math.abs(b.x + b.w / 2 - want) * 0.4)
          )
          const near = pool.slice(0, Math.min(s.style === 1 ? 7 : 4, pool.length))
          const line = near[Math.floor(Math.random() * near.length)]
          const drift = (Math.random() - 0.5) * ([18, 48, 26][s.style] + Math.random() * 16)
          tx = clamp(s.pos.x + drift, line.x + 10, line.x + line.w - 10)
          ty = line.y
        } else {
          const line = pickLine(pool0, preferLower, s.lane)
          tx = clamp(
            line.x + 10 + Math.random() * Math.max(8, line.w - 20),
            line.x + 10,
            line.x + line.w - 10
          )
          ty = line.y
        }
      }
      tx = clamp(tx, pad.left, pad.right)
      ty = clamp(ty, pad.top, pad.bottom)
      if (tooClose(tx, ty, s)) {
        tx += s.lane > 0.5 ? 48 : -48
        tx = clamp(tx, pad.left, pad.right)
      }
      // Cap one hop so spiders don't vault across the whole viewport.
      const maxHop = [150, 220, 180][s.style]
      let hopDx = tx - s.pos.x
      let hopDy = ty - s.pos.y
      const hop = Math.hypot(hopDx, hopDy)
      if (hop > maxHop) {
        const k = maxHop / hop
        tx = s.pos.x + hopDx * k
        ty = s.pos.y + hopDy * k
        tx = clamp(tx, pad.left, pad.right)
        ty = clamp(ty, pad.top, pad.bottom)
      }
      s.from = { x: s.pos.x, y: s.pos.y }
      s.to = { x: tx, y: ty }
      s.t = 0
      const dist = Math.max(12, Math.hypot(tx - s.pos.x, ty - s.pos.y))
      const speed = ([92, 46, 68][s.style] + Math.random() * 36) * s.tempo
      s.dur = clamp(dist / speed, 0.18, [0.9, 1.8, 1.25][s.style])
      s.wobble =
        (Math.random() < 0.5 ? -1 : 1) * ([6, 22, 12][s.style] + Math.random() * 10)
      s.phase = 'move'
      s.heading = Math.atan2(ty - s.pos.y, tx - s.pos.x)
      s.gaitT = Math.random() * 0.08
      s.bob = 0
      // Release plants so the first swing can re-anchor cleanly.
      for (let i = 0; i < s.feet.length; i++) {
        s.feet[i].hold = null
        s.feet[i].swingFrom = null
      }
    }

    resizeSilk()
    syncPack()
    linesInView(true)
    let last = performance.now()
    let packAt = 0

    const tick = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000)
      last = now
      const view = linesInView()
      if (now - packAt > 400) {
        syncPack()
        packAt = now
      }
      const cyber = cyberOn()

      spiders.forEach((s) => {
          if (!cyber && (s.phase === 'wait' || s.phase === 'drop' || s.phase === 'lift' || s.phase === 'gather')) {
            s.phase = 'hold'
            s.holdLeft = 0
            s.crawlLeft = 99
          }

          if (s.phase === 'wait') {
            s.holdLeft -= dt
            if (s.holdLeft <= 0) {
              if (cyber) {
                if (ropeBusy(s)) {
                  s.holdLeft = 1.5 + Math.random() * 1.1
                } else {
                  beginDrop(s, view)
                }
              } else {
                beginMove(s, view)
                s.crawlLeft = 99
              }
            }
            if (s.phase === 'wait') {
              s.mark.style.opacity = '0'
              return
            }
          } else if (s.phase === 'gather') {
            s.t += dt / s.dur
            s.heading = -Math.PI / 2
            if (s.t >= 1) {
              const hanging = petals.some(
                (p) => p.owner === s.id && p.rewind && !p.stuck
              )
              if (!hanging || s.t >= 1.4) {
                beginLift(s)
              }
            }
          } else if (s.phase === 'drop' || s.phase === 'lift') {
            s.t += dt / s.dur
            const u = clamp(s.t, 0, 1)
            const e = ease(u)
            const sky = s.phase === 'drop' ? s.from : s.to
            const end = s.phase === 'drop' ? s.to : s.from
            const k = s.phase === 'drop' ? e : 1 - e
            s.pos = ropePoint(sky, end, k, now)
            s.heading = s.phase === 'drop' ? Math.PI / 2 : -Math.PI / 2
            if (s.phase === 'drop' && now - s.sparkAt > 90) {
              explodeAlongRope(s, sky, s.pos, now, 10)
              s.sparkAt = now
            }
            if (u >= 1) {
              if (s.phase === 'drop') {
                s.pos = { ...s.to }
                s.crawlLeft = [14.2, 16.8, 15.0][s.style] + Math.random() * 1.6
                beginMove(s, view)
              } else {
                s.phase = 'wait'
                s.holdLeft = [0.35, 1.4, 0.7][s.style] + Math.random() * 0.5
              }
            }
          } else if (s.phase === 'hold') {
            s.holdLeft -= dt
            s.crawlLeft -= dt
            if (s.holdLeft <= 0) {
              if (cyber && s.crawlLeft <= 0) {
                if (ropeBusy(s)) {
                  s.holdLeft = 1.6 + Math.random() * 1.2
                } else {
                  beginGather(s)
                }
              } else {
                beginMove(s, view)
              }
            }
          } else {
            // Surge forward as each tetrapod plants; ease between pushes so it
            // pauses/bobs instead of skating in one continuous ease.
            const pulse = Math.pow(Math.sin(s.gaitT * Math.PI * 2), 2)
            s.t += (dt / s.dur) * (0.38 + 0.95 * pulse)
            s.crawlLeft -= dt
            const u = clamp(s.t, 0, 1)
            const e = ease(u)
            const dx = s.to.x - s.from.x
            const dy = s.to.y - s.from.y
            const dist = Math.hypot(dx, dy) || 1
            const bow = Math.sin(u * Math.PI) * s.wobble * 0.65
            const prev = { x: s.pos.x, y: s.pos.y }
            s.pos = {
              x: s.from.x + dx * e + (-dy / dist) * bow,
              y: s.from.y + dy * e + (dx / dist) * bow
            }
            const vx = s.pos.x - prev.x
            const vy = s.pos.y - prev.y
            if (Math.hypot(vx, vy) > 0.2) {
              s.heading = Math.atan2(vy, vx)
            }
            if (u >= 1) {
              s.pos = { x: s.to.x, y: s.to.y }
              s.bob = 0
              if (cyber && s.crawlLeft <= 0) {
                if (ropeBusy(s)) {
                  s.phase = 'hold'
                  s.holdLeft = 1.6 + Math.random() * 1.2
                } else {
                  beginGather(s)
                }
              } else {
                s.phase = 'hold'
                s.holdLeft =
                  [0.08, 0.28, 0.12][s.style] + Math.random() * [0.12, 0.35, 0.18][s.style]
              }
            }
          }

          const reach =
            s.phase === 'move' ? s.to : s.phase === 'drop' || s.phase === 'lift' ? s.to : null
          stepFeet(s, now, dt, reach, s.phase === 'move')
          s.trail.push({ x: s.pos.x, y: s.pos.y, at: now })
          if (s.trail.length > 18 || (s.trail[0] && now - s.trail[0].at > 900)) {
            s.trail.shift()
          }

          if (s.phase !== 'move' && s.phase !== 'hold') {
            s.mark.style.opacity = '0'
            return
          }
          if (now - s.lastWordAt < 90) {
            return
          }
          s.lastWordAt = now
          const word = wordAt(s.pos.x, s.pos.y)
          if (word) {
            s.mark.style.opacity = '1'
            s.mark.style.transform = `translate(${word.rect.left}px, ${word.rect.top}px)`
            s.mark.style.width = `${word.rect.width}px`
            s.mark.style.height = `${word.rect.height}px`
            if (cyber) {
              floatWord(word.rect, word.text, now)
            }
          } else {
            s.mark.style.opacity = '0'
          }
      })

      stepPetals(dt, now)
      if (cyber && (petals.length || spiders.some((s) => s.phase === 'drop' || s.phase === 'lift' || s.phase === 'gather'))) {
        drawBloom(now)
      } else if (btx) {
        btx.setTransform(1, 0, 0, 1, 0, 0)
        btx.clearRect(0, 0, bloom.width, bloom.height)
      }

      if (ctx) {
        ctx.setTransform(1, 0, 0, 1, 0, 0)
        ctx.clearRect(0, 0, silk.width, silk.height)
        ctx.setTransform(silkDpr, 0, 0, silkDpr, 0, 0)
        ctx.lineCap = 'round'
        ctx.lineJoin = 'round'
        ctx.shadowBlur = 0
        spiders.forEach((s) => {
          if (s.phase === 'drop' || s.phase === 'lift' || s.phase === 'gather') {
            const sky = s.phase === 'drop' ? s.from : s.to
            drawRope(sky, s.pos, now)
          }
          if (s.trail.length > 1) {
            ctx.beginPath()
            ctx.moveTo(s.trail[0].x, s.trail[0].y)
            for (let i = 1; i < s.trail.length; i++) {
              ctx.lineTo(s.trail[i].x, s.trail[i].y)
            }
            const age = 1 - (now - s.trail[s.trail.length - 1].at) / 900
            ctx.strokeStyle = `rgba(255, 106, 31, ${Math.max(0.12, age) * 0.5})`
            ctx.lineWidth = 1
            ctx.stroke()
          }
          if (s.phase === 'wait') {
            return
          }
          // Far legs under body, near legs on top — cheap depth layering.
          const legOrder = [0, 1, 2, 3, 4, 5, 6, 7].sort(
            (a, b) => legNear(a, s.heading) - legNear(b, s.heading)
          )
          const drawOneLeg = (i: number) => {
            const along = slots[i % 4]
            const side = i < 4 ? -1 : 1
            const perp = s.heading + Math.PI / 2
            const near = legNear(i, s.heading)
            const hip = {
              x:
                s.pos.x +
                Math.cos(s.heading) * along * 0.35 +
                Math.cos(perp) * side * (2.6 + near * 1.1),
              y:
                s.pos.y +
                s.bob +
                Math.sin(s.heading) * along * 0.35 +
                Math.sin(perp) * side * (2.0 + near * 0.9) +
                near * 1.4
            }
            drawLeg(hip, s.feet[i], side, near)
          }
          for (let n = 0; n < 4; n++) {
            drawOneLeg(legOrder[n])
          }
          if (cyber) {
            drawHud(s.pos.x, s.pos.y + s.bob, now)
          }
          drawBody(s.pos, s.heading, s.bob)
          for (let n = 4; n < 8; n++) {
            drawOneLeg(legOrder[n])
          }
        })
      }
      requestAnimationFrame(tick)
    }

    function jostleFloor(dy: number) {
      const power = clamp(dy / 18, 0.2, 4.2)
      for (let i = 0; i < petals.length; i++) {
        const p = petals[i]
        if (p.rewind || p.stuck) {
          continue
        }
        if (!p.grounded && p.y < window.innerHeight - 90) {
          continue
        }
        p.grounded = false
        p.vy = -55 * power - Math.random() * 95 * power
        p.vx += (Math.random() - 0.5) * 55 * power
        p.rotv += (Math.random() - 0.5) * 6 * power
      }
    }

    let lastScrollY = window.scrollY
    window.addEventListener(
      'scroll',
      () => {
        linesAt = 0
        const y = window.scrollY
        const dy = y - lastScrollY
        lastScrollY = y
        if (!cyberOn() || !petals.length || dy <= 0.4) {
          return
        }
        jostleFloor(dy)
      },
      { passive: true }
    )
    window.addEventListener('resize', () => {
      resizeSilk()
      syncPack()
      linesInView(true)
    })
    requestAnimationFrame(tick)
  }
</script>

