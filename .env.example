# Notion CMS — Internal Integration secret (never commit real .env)
# Create at https://www.notion.so/my-integrations → copy "Internal Integration Secret"
# Leave unset for local builds (Notion collection no-ops; markdown blog still works)
NOTION_TOKEN=

# Database ID (32-hex from Notion URL, with or without dashes)
NOTION_DATABASE_ID=2570b37ec46a4bf39795c1bbb6a66d8d

# Data source ID (Notion API 2025+ / @luanroger/notion-astro-loader)
NOTION_DATA_SOURCE_ID=a1a3b01e-711c-42fb-b3c1-c05b796fccfe

# Optional Giscus overrides (also configurable in src/site.config.ts)
# PUBLIC_GISCUS_ENABLE=true
# PUBLIC_GISCUS_REPO=luluyuzhi/pure-blog
# PUBLIC_GISCUS_REPO_ID=
# PUBLIC_GISCUS_CATEGORY=Announcements
# PUBLIC_GISCUS_CATEGORY_ID=

# Douban shelf (build-time Frodo fetch)
# Profile: https://www.douban.com/people/153627368/
DOUBAN_USER_ID=153627368
